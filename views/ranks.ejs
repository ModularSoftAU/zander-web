<%- include("modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: pageDescription
}) %>

<%- include("modules/navigationBar.ejs") %>

<%- include("partials/miniHeader.ejs", {
  headerTitle: "Ranks",
  backgroundImage: globalImage
}) %>

<section class="section">
  <div class="container">

    <% if (ranksError) { %>
      <div class="alert alert-warning"><%= ranksError %></div>
    <% } else if (!rankCategories || !rankCategories.length) { %>
      <div class="alert alert-info">Rank information is being updated — check back soon!</div>
    <% } else { %>

      <% rankCategories.forEach(function(category) { %>
        <h3 class="mb-1"><%= category.displayName %></h3>
        <hr class="mt-2 mb-4">

        <div class="row g-4 mb-5">
          <% category.packages.forEach(function(pkg) { %>
            <div class="col-lg-4 col-md-6 col-sm-12">
              <div class="card h-100 shadow-sm border-0">

                <% if (pkg.imageUrl) { %>
                  <img src="<%= pkg.imageUrl %>" alt="<%= pkg.displayName %>" class="card-img-top"
                       style="height: 120px; object-fit: contain; object-position: center; padding: 1rem;">
                <% } %>

                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title mb-0"><%= pkg.displayName %></h5>
                    <span class="badge <%= pkg.badgeLabel === 'Monthly' ? 'bg-primary' : 'bg-success' %> ms-2 flex-shrink-0">
                      <%= pkg.badgeLabel %>
                    </span>
                  </div>

                  <% if (pkg.description) { %>
                    <p class="text-muted small mb-3"><%= pkg.description %></p>
                  <% } %>

                  <% if (pkg.features && pkg.features.length) { %>
                    <ul class="list-unstyled mb-3 flex-grow-1">
                      <% pkg.features.forEach(function(feature) { %>
                        <li class="small mb-1">
                          <i class="fa-solid fa-check text-success me-2"></i><%= feature %>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <div class="flex-grow-1"></div>
                  <% } %>

                  <div class="mt-auto pt-2 border-top">
                    <p class="fs-5 fw-bold mb-2">
                      <%= pkg.priceDisplay %>
                      <% if (pkg.badgeLabel === 'Monthly') { %>
                        <small class="text-muted fw-normal fs-6">/ month</small>
                      <% } %>
                    </p>
                    <a href="/webstore#ws-<%= pkg.stripePriceId %>" class="btn btn-primary btn-sm w-100">
                      <i class="fa-solid fa-cart-shopping me-1"></i>
                      <% if (pkg.badgeLabel === 'Monthly') { %>Subscribe<% } else { %>Buy Now<% } %>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          <% }) %>
        </div>

      <% }) %>

    <% } %>
  </div>
</section>

<%- include("modules/footer.ejs") %>
