<%- include("../../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: mode === 'create' ? 'Create Template' : 'Edit Template'
}) %>

<%- include("../../modules/navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: mode === 'create' ? 'Create Template' : 'Edit Template',
  backgroundImage: globalImage
}) %>

<%- include("../../modules/dashboard/dashboard-header.ejs") %>

<%
const tmpl = templateData || {};
const recDays = (() => {
    try { return Array.isArray(tmpl.recurrenceDays) ? tmpl.recurrenceDays : JSON.parse(tmpl.recurrenceDays || '[]'); }
    catch(e) { return []; }
})();
const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
%>

<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <%- include("../../modules/dashboard/dashboard-sidebar.ejs") %>
        </div>
        <main class="col-lg-9">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2"><%= mode === 'create' ? 'Create Template' : 'Edit Template' %></h1>
                <a href="/dashboard/events/templates" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left fa-fw me-1"></i>Back
                </a>
            </div>

            <% if (req.cookies.alertType) { %>
                <%- include("../../partials/alert.ejs", {
                  alertType: req.cookies.alertType,
                  content: req.cookies.alertContent
                }) %>
            <% } %>

            <form id="templateForm">
                <% if (mode === 'edit') { %>
                    <input type="hidden" name="templateId" value="<%= tmpl.templateId %>">
                <% } %>

                <div class="card mb-3">
                    <div class="card-header">Basic Info</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Template Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="title" value="<%= tmpl.title || '' %>" required maxlength="255">
                            <small class="text-muted">This becomes the default event title for generated drafts.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Default Description</label>
                            <textarea class="form-control" name="description" id="tmplDescriptionEditor" rows="4"><%= tmpl.description || '' %></textarea>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Default Start Time</label>
                                <input type="time" class="form-control" name="defaultStartTime" value="<%= tmpl.defaultStartTime || '' %>">
                                <small class="text-muted">In UTC.</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Default End Time</label>
                                <input type="time" class="form-control" name="defaultEndTime" value="<%= tmpl.defaultEndTime || '' %>">
                                <small class="text-muted">In UTC.</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Duration (mins)</label>
                                <input type="number" class="form-control" name="defaultDurationMins" min="1" value="<%= tmpl.defaultDurationMins || '' %>" placeholder="60">
                                <small class="text-muted">Used if no end time set.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Recurrence</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Recurrence Type</label>
                            <select class="form-select" name="recurrenceType" id="recurrenceType">
                                <option value="weekly" <%= (tmpl.recurrenceType || 'weekly') === 'weekly' ? 'selected' : '' %>>Weekly (specific days)</option>
                                <option value="daily" <%= tmpl.recurrenceType === 'daily' ? 'selected' : '' %>>Daily</option>
                                <option value="custom" <%= tmpl.recurrenceType === 'custom' ? 'selected' : '' %>>Every N Days</option>
                            </select>
                        </div>

                        <div id="weeklyOptions" class="mb-3 <%= (tmpl.recurrenceType || 'weekly') !== 'weekly' ? 'd-none' : '' %>">
                            <label class="form-label fw-semibold">Days of Week</label>
                            <div class="d-flex flex-wrap gap-2">
                                <% dayNames.forEach((day, i) => { %>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input recurrence-day" type="checkbox" value="<%= i %>" id="day_<%= i %>" <%= recDays.includes(i) ? 'checked' : '' %>>
                                    <label class="form-check-label" for="day_<%= i %>"><%= day %></label>
                                </div>
                                <% }) %>
                            </div>
                            <input type="hidden" name="recurrenceDaysJson" id="recurrenceDaysJson">
                        </div>

                        <div id="customOptions" class="mb-3 <%= tmpl.recurrenceType !== 'custom' ? 'd-none' : '' %>">
                            <label class="form-label fw-semibold">Every N Days</label>
                            <input type="number" class="form-control" name="recurrenceEveryDays" min="1" value="<%= tmpl.recurrenceEveryDays || '' %>" placeholder="7">
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Draft Lead Time (days)</label>
                                <input type="number" class="form-control" name="draftAdvanceDays" min="0" value="<%= tmpl.draftAdvanceDays || 7 %>">
                                <small class="text-muted">Generate the draft this many days before the event.</small>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="autoGenerateDrafts" id="autoGenCheck" value="true" <%= (tmpl.autoGenerateDrafts !== false) ? 'checked' : '' %>>
                                    <label class="form-check-label" for="autoGenCheck">Auto-generate drafts</label>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="isActive" id="isActiveCheck" value="true" <%= (tmpl.isActive !== false) ? 'checked' : '' %>>
                                    <label class="form-check-label" for="isActiveCheck">Template active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Default Location</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Location Type</label>
                            <div class="d-flex gap-2 flex-wrap" id="tmplLocationTypeBtns">
                                <% const tlt = tmpl.locationType || 'other'; %>
                                <button type="button" class="btn btn-sm tmpl-loc-type-btn <%= tlt === 'discord' ? 'btn-primary' : 'btn-outline-secondary' %>" data-type="discord">
                                    <i class="fab fa-discord me-1"></i>Discord Voice
                                </button>
                                <button type="button" class="btn btn-sm tmpl-loc-type-btn <%= tlt === 'minecraft' ? 'btn-primary' : 'btn-outline-secondary' %>" data-type="minecraft">
                                    <i class="fas fa-cubes me-1"></i>Minecraft Server
                                </button>
                                <button type="button" class="btn btn-sm tmpl-loc-type-btn <%= tlt === 'other' ? 'btn-primary' : 'btn-outline-secondary' %>" data-type="other">
                                    <i class="fas fa-map-marker-alt me-1"></i>Other
                                </button>
                            </div>
                            <input type="hidden" name="locationType" id="tmplLocationType" value="<%= tmpl.locationType || 'other' %>">
                        </div>

                        <!-- Discord voice channel picker -->
                        <div id="tmpl-loc-discord" class="row g-3 mb-3 <%= (tmpl.locationType || 'other') !== 'discord' ? 'd-none' : '' %>">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Voice Channel</label>
                                <select class="form-select" id="tmplLocationDiscordChannelId">
                                    <option value="">Loading channels…</option>
                                </select>
                            </div>
                        </div>

                        <!-- Minecraft server -->
                        <div id="tmpl-loc-minecraft" class="row g-3 mb-3 <%= (tmpl.locationType || 'other') !== 'minecraft' ? 'd-none' : '' %>">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Server Name</label>
                                <input type="text" class="form-control" id="tmplServerName" value="<%= tmpl.serverName || '' %>" placeholder="e.g. Survival">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Server IP</label>
                                <input type="text" class="form-control" id="tmplServerIp" value="<%= tmpl.serverIp || '' %>" placeholder="e.g. play.example.com">
                            </div>
                        </div>

                        <!-- Other / free-text -->
                        <div id="tmpl-loc-other" class="row g-3 mb-3 <%= (tmpl.locationType || 'other') !== 'other' ? 'd-none' : '' %>">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Location</label>
                                <input type="text" class="form-control" id="tmplLocationLabelOther"
                                    value="<%= (tmpl.locationType === 'other' || !tmpl.locationType) ? (tmpl.locationLabel || '') : '' %>"
                                    placeholder="e.g. Main Hall, Event Arena…">
                            </div>
                        </div>

                        <!-- Hidden fields submitted with form -->
                        <input type="hidden" name="locationLabel" id="tmplLocationLabel" value="<%= tmpl.locationLabel || '' %>">
                        <input type="hidden" name="locationDiscordChannelId" id="tmplLocationDiscordChannelId" value="<%= tmpl.locationDiscordChannelId || '' %>">
                        <input type="hidden" name="serverName" id="tmplServerNameHidden" value="<%= tmpl.serverName || '' %>">
                        <input type="hidden" name="serverIp" id="tmplServerIpHidden" value="<%= tmpl.serverIp || '' %>">
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Default Branding</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Banner URL</label>
                            <input type="url" class="form-control" name="bannerUrl" value="<%= tmpl.bannerUrl || '' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Logo URL</label>
                            <input type="url" class="form-control" name="logoUrl" value="<%= tmpl.logoUrl || '' %>">
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between">
                        <span>Default Hosts</span>
                        <button type="button" class="btn btn-sm btn-primary" id="addTemplateHostBtn">
                            <i class="fas fa-plus me-1"></i>Add Host
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="templateHostsContainer">
                            <% const defaultHosts = tmpl.defaultHosts || []; %>
                            <% defaultHosts.forEach((h, i) => { %>
                            <div class="host-row border rounded p-3 mb-2 position-relative">
                                <button type="button" class="btn btn-xs btn-danger position-absolute top-0 end-0 m-2 remove-host">×</button>
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label small">Player <span class="text-muted">(linked accounts only)</span></label>
                                        <div class="position-relative">
                                            <input type="text" class="form-control form-control-sm host-userSearch" placeholder="Search by username…" autocomplete="off" value="<%= h.displayName || '' %>">
                                            <div class="host-suggestions list-group position-absolute w-100" style="z-index:1000;top:100%;left:0;display:none;"></div>
                                        </div>
                                        <input type="hidden" class="host-userId" value="<%= h.userId || '' %>">
                                        <input type="hidden" class="host-discordUserId" value="<%= h.discordUserId || '' %>">
                                        <input type="hidden" class="host-displayName" value="<%= h.displayName || '' %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Role</label>
                                        <select class="form-select form-select-sm host-role">
                                            <option value="host" <%= h.role === 'host' ? 'selected' : '' %>>Host</option>
                                            <option value="co_host" <%= h.role === 'co_host' ? 'selected' : '' %>>Co-Host</option>
                                            <option value="coordinator" <%= h.role === 'coordinator' ? 'selected' : '' %>>Coordinator</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <input type="hidden" name="defaultHostsJson" id="defaultHostsJson">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i><%= mode === 'create' ? 'Create Template' : 'Save Template' %>
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

<%- include("../../modules/footer.ejs") %>

<style>.btn-xs { padding: 0.15rem 0.5rem; font-size: 0.75rem; }</style>

<script>
// Recurrence type toggle
const recTypeSelect = document.getElementById('recurrenceType');
const weeklyOpts = document.getElementById('weeklyOptions');
const customOpts = document.getElementById('customOptions');

function toggleRecurrenceOptions() {
    const val = recTypeSelect.value;
    weeklyOpts.classList.toggle('d-none', val !== 'weekly');
    customOpts.classList.toggle('d-none', val !== 'custom');
}
recTypeSelect.addEventListener('change', toggleRecurrenceOptions);

// Hosts — autofill search
function initTemplateHostSearch(row) {
    const searchInput = row.querySelector('.host-userSearch');
    const suggestionsEl = row.querySelector('.host-suggestions');
    const userIdInput = row.querySelector('.host-userId');
    const discordIdInput = row.querySelector('.host-discordUserId');
    const displayNameInput = row.querySelector('.host-displayName');

    if (!searchInput || !suggestionsEl) return;

    let searchTimeout;

    const clearSuggestions = () => {
        suggestionsEl.innerHTML = '';
        suggestionsEl.style.display = 'none';
    };

    const selectUser = (user) => {
        searchInput.value = user.username;
        userIdInput.value = user.userId;
        discordIdInput.value = user.discordId || '';
        displayNameInput.value = user.username;
        clearSuggestions();
    };

    const renderSuggestions = (results) => {
        clearSuggestions();
        if (!results.length) return;
        results.forEach(user => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 px-2';
            if (user.avatarUrl) {
                const img = document.createElement('img');
                img.src = user.avatarUrl;
                img.alt = '';
                img.width = 28;
                img.height = 28;
                img.className = 'rounded';
                btn.appendChild(img);
            }
            const span = document.createElement('span');
            span.textContent = user.username;
            span.className = 'flex-fill text-start small';
            btn.appendChild(span);
            btn.addEventListener('click', () => selectUser(user));
            suggestionsEl.appendChild(btn);
        });
        suggestionsEl.style.display = 'block';
    };

    const doSearch = async (term) => {
        if (!term || term.length < 2) { clearSuggestions(); return; }
        try {
            const res = await fetch(`/api/events/users/search?q=${encodeURIComponent(term)}`, {
                credentials: 'include',
                headers: { 'x-access-token': '<%= process.env.apiKey %>' },
            });
            if (!res.ok) { clearSuggestions(); return; }
            const data = await res.json();
            renderSuggestions(data.results || []);
        } catch { clearSuggestions(); }
    };

    searchInput.addEventListener('input', (e) => {
        userIdInput.value = '';
        discordIdInput.value = '';
        displayNameInput.value = e.target.value;
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => doSearch(e.target.value.trim()), 250);
    });

    document.addEventListener('click', (e) => {
        if (!row.contains(e.target)) clearSuggestions();
    });
}

function addTemplateHost(host = {}) {
    const row = document.createElement('div');
    row.className = 'host-row border rounded p-3 mb-2 position-relative';
    row.innerHTML = `
        <button type="button" class="btn btn-xs btn-danger position-absolute top-0 end-0 m-2 remove-host">×</button>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label small">Player <span class="text-muted">(linked accounts only)</span></label>
                <div class="position-relative">
                    <input type="text" class="form-control form-control-sm host-userSearch" placeholder="Search by username…" autocomplete="off" value="${host.displayName||''}">
                    <div class="host-suggestions list-group position-absolute w-100" style="z-index:1000;top:100%;left:0;display:none;"></div>
                </div>
                <input type="hidden" class="host-userId" value="${host.userId||''}">
                <input type="hidden" class="host-discordUserId" value="${host.discordUserId||''}">
                <input type="hidden" class="host-displayName" value="${host.displayName||''}">
            </div>
            <div class="col-md-3"><label class="form-label small">Role</label>
                <select class="form-select form-select-sm host-role">
                    <option value="host" ${host.role==='host'?'selected':''}>Host</option>
                    <option value="co_host" ${host.role==='co_host'?'selected':''}>Co-Host</option>
                    <option value="coordinator" ${host.role==='coordinator'?'selected':''}>Coordinator</option>
                </select>
            </div>
        </div>`;
    row.querySelector('.remove-host').addEventListener('click', () => row.remove());
    document.getElementById('templateHostsContainer').appendChild(row);
    initTemplateHostSearch(row);
}

document.getElementById('addTemplateHostBtn').addEventListener('click', () => addTemplateHost());
document.querySelectorAll('#templateHostsContainer .remove-host').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.host-row').remove());
});
document.querySelectorAll('#templateHostsContainer .host-row').forEach(initTemplateHostSearch);

// Location picker
(function initTmplLocationPicker() {
    const typeInput = document.getElementById('tmplLocationType');
    const sections = {
        discord:   document.getElementById('tmpl-loc-discord'),
        minecraft: document.getElementById('tmpl-loc-minecraft'),
        other:     document.getElementById('tmpl-loc-other'),
    };
    const btns = document.querySelectorAll('.tmpl-loc-type-btn');

    function setType(type) {
        typeInput.value = type;
        Object.keys(sections).forEach(k => sections[k].classList.toggle('d-none', k !== type));
        btns.forEach(b => {
            b.classList.toggle('btn-primary', b.dataset.type === type);
            b.classList.toggle('btn-outline-secondary', b.dataset.type !== type);
        });
    }
    btns.forEach(b => b.addEventListener('click', () => setType(b.dataset.type)));

    // Load voice channels
    const voiceSelect = document.getElementById('tmplLocationDiscordChannelId');
    const savedChannelId = '<%= tmpl.locationDiscordChannelId || "" %>';
    async function loadVoiceChannels() {
        try {
            const res = await fetch('/api/events/discord/voice-channels', { credentials: 'include', headers: { 'x-access-token': '<%= process.env.apiKey %>' } });
            const data = await res.json();
            voiceSelect.innerHTML = '<option value="">— select a channel —</option>';
            let lastCat = null, grp;
            data.channels.forEach(ch => {
                if (ch.category !== lastCat) {
                    grp = document.createElement('optgroup');
                    grp.label = ch.category || 'Uncategorised';
                    voiceSelect.appendChild(grp);
                    lastCat = ch.category;
                }
                const opt = document.createElement('option');
                opt.value = ch.id;
                opt.textContent = ch.name;
                if (ch.id === savedChannelId) opt.selected = true;
                (grp || voiceSelect).appendChild(opt);
            });
            if (!data.channels.length) voiceSelect.innerHTML = '<option value="">No voice channels found</option>';
        } catch { voiceSelect.innerHTML = '<option value="">Failed to load channels</option>'; }
    }
    loadVoiceChannels();
})();

// Form submission
document.getElementById('templateForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const body = Object.fromEntries(fd.entries());

    // Sync Summernote description
    if (typeof $.fn.summernote !== 'undefined') {
        body.description = $('#tmplDescriptionEditor').summernote('code');
    }

    // Recurrence days
    const days = Array.from(document.querySelectorAll('.recurrence-day:checked')).map(cb => parseInt(cb.value));
    body.recurrenceDays = days;
    body.autoGenerateDrafts = document.getElementById('autoGenCheck').checked;
    body.isActive = document.getElementById('isActiveCheck').checked;
    body.recurrenceEveryDays = body.recurrenceEveryDays ? parseInt(body.recurrenceEveryDays) : null;
    body.defaultDurationMins = body.defaultDurationMins ? parseInt(body.defaultDurationMins) : null;
    body.draftAdvanceDays = parseInt(body.draftAdvanceDays) || 7;

    // Location — consolidate based on active type
    const locType = document.getElementById('tmplLocationType').value;
    body.locationType = locType;
    if (locType === 'discord') {
        const sel = document.getElementById('tmplLocationDiscordChannelId');
        body.locationDiscordChannelId = sel.value || null;
        body.locationLabel = sel.options[sel.selectedIndex]?.textContent?.trim() || null;
        body.serverName = null;
        body.serverIp = null;
    } else if (locType === 'minecraft') {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('tmplServerName')?.value || null;
        body.serverName = document.getElementById('tmplServerName')?.value || null;
        body.serverIp = document.getElementById('tmplServerIp')?.value || null;
    } else {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('tmplLocationLabelOther')?.value || null;
        body.serverName = null;
        body.serverIp = null;
    }

    // Hosts
    body.defaultHosts = Array.from(document.querySelectorAll('#templateHostsContainer .host-row')).map(row => ({
        displayName: row.querySelector('.host-displayName')?.value || null,
        role: row.querySelector('.host-role')?.value || 'host',
        discordUserId: row.querySelector('.host-discordUserId')?.value || null,
        userId: row.querySelector('.host-userId')?.value || null,
    })).filter(h => h.userId || h.displayName);

    const endpoint = '<%= mode === "create" ? "/api/events/templates/create" : "/api/events/templates/update" %>';
    const res = await fetch(endpoint, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', 'x-access-token': '<%= process.env.apiKey %>' },
        body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) window.location.href = '/dashboard/events/templates';
    else alert('Error: ' + data.message);
});

// Summernote description editor
$(document).ready(function () {
    $('#tmplDescriptionEditor').summernote({
        height: 200,
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'strikethrough']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['insert', ['link']],
            ['view', ['fullscreen', 'codeview']],
        ],
        styleTags: ['p', 'h3', 'h4', 'blockquote'],
    });
});
</script>
