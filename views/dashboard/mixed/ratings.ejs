<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Ratings & Feedback</h1>
  </div>
  <p class="text-muted small">Feedback management only — no moderation cases or punishments are created here.</p>

  <div id="mixedAlert" class="alert d-none"></div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <h6>Highest rated</h6>
      <ul class="list-group list-group-flush">
        <% overview.highest.forEach(function(m){ %><li class="list-group-item d-flex justify-content-between py-1"><span><%= m.name %></span><span><%= Number(m.average_overall).toFixed(2) %>★</span></li><% }) %>
      </ul>
    </div>
    <div class="col-md-4">
      <h6>Lowest rated</h6>
      <ul class="list-group list-group-flush">
        <% overview.lowest.forEach(function(m){ %><li class="list-group-item d-flex justify-content-between py-1"><span><%= m.name %></span><span><%= Number(m.average_overall).toFixed(2) %>★</span></li><% }) %>
      </ul>
    </div>
    <div class="col-md-4">
      <h6>Few ratings</h6>
      <ul class="list-group list-group-flush">
        <% overview.fewRatings.forEach(function(m){ %><li class="list-group-item d-flex justify-content-between py-1"><span><%= m.name %></span><span><%= m.rating_count %></span></li><% }) %>
      </ul>
    </div>
  </div>

  <form class="row g-2 mb-3" method="get">
    <div class="col-md-3"><input class="form-control form-control-sm" name="map" placeholder="map_key" value="<%= query.map || '' %>"></div>
    <div class="col-md-2"><input class="form-control form-control-sm" name="rating" placeholder="rating 1-5" value="<%= query.rating || '' %>"></div>
    <div class="col-md-3"><input class="form-control form-control-sm" name="player" placeholder="player uuid" value="<%= query.player || '' %>"></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary">Filter</button></div>
  </form>

  <table class="table table-sm align-middle">
    <thead><tr><th>Map</th><th>★</th><th>Player</th><th>Feedback</th><th>Visible</th><th></th></tr></thead>
    <tbody>
      <% feedback.forEach(function(f){ %>
        <tr data-id="<%= f.id %>">
          <td><%= f.map_key %></td><td><%= f.overall_rating %></td><td><%= f.username || f.player_uuid %></td>
          <td class="small"><%= f.feedback %></td>
          <td><span class="badge <%= f.feedback_visible?'bg-success':'bg-secondary' %>"><%= f.feedback_visible?'Public':'Hidden' %></span></td>
          <td>
            <button class="btn btn-sm btn-outline-warning hide-fb">Hide</button>
            <button class="btn btn-sm btn-outline-danger del-fb">Delete</button>
          </td>
        </tr>
      <% }) %>
      <% if (!feedback.length) { %><tr><td colspan="6" class="text-muted text-center">No feedback.</td></tr><% } %>
    </tbody>
  </table>
</div></div></div>

<script>
  const alertEl = document.getElementById('mixedAlert');
  function notify(ok,msg){ alertEl.className='alert alert-'+(ok?'success':'danger'); alertEl.textContent=msg; alertEl.classList.remove('d-none'); }
  document.querySelectorAll('.hide-fb').forEach(b=>b.addEventListener('click', async()=>{ const id=b.closest('tr').dataset.id; const r=await fetch('/api/admin/mixed/ratings/'+id+'/hide',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:'Hidden by admin'})}); const j=await r.json(); notify(j.success,j.success?'Hidden.':j.message); if(j.success)setTimeout(()=>location.reload(),500); }));
  document.querySelectorAll('.del-fb').forEach(b=>b.addEventListener('click', async()=>{ if(!confirm('Delete this feedback?'))return; const id=b.closest('tr').dataset.id; const r=await fetch('/api/admin/mixed/ratings/'+id+'/remove',{method:'POST'}); const j=await r.json(); notify(j.success,j.success?'Deleted.':j.message); if(j.success)setTimeout(()=>location.reload(),500); }));
</script>

<%- include("../../admin/_footer.ejs") %>
