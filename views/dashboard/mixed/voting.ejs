<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Voting</h1>
  </div>

  <div id="mixedAlert" class="alert d-none"></div>

  <div class="row g-4">
    <div class="col-lg-6">
      <h5>Voting settings</h5>
      <form id="settingsForm">
        <% const fields = [['vote_duration_seconds','Vote duration (s)'],['vote_options_count','Options per vote'],['map_cooldown_minutes','Map cooldown (min)'],['player_cooldown_minutes','Player cooldown (min)'],['token_nominate_cost','Nominate cost'],['token_set_next_cost','Set-next cost'],['token_sponsor_cost','Sponsor cost'],['token_boost_weight','Token boost weight']]; %>
        <% fields.forEach(function(f){ %>
          <div class="mb-2 row"><label class="col-sm-6 col-form-label col-form-label-sm"><%= f[1] %></label>
            <div class="col-sm-6"><input type="number" class="form-control form-control-sm" name="<%= f[0] %>" value="<%= settings[f[0]] %>"></div></div>
        <% }) %>
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="allow_web_voting" <%= settings.allow_web_voting?'checked':'' %>><label class="form-check-label">Allow web voting</label></div>
        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="public_feedback_enabled" <%= settings.public_feedback_enabled?'checked':'' %>><label class="form-check-label">Show feedback publicly</label></div>
        <button class="btn btn-primary btn-sm">Save settings</button>
      </form>
    </div>

    <div class="col-lg-6">
      <h5>Start a vote</h5>
      <form id="startVoteForm" class="mb-4">
        <input class="form-control form-control-sm mb-2" name="vote_id" placeholder="Vote ID" required>
        <input class="form-control form-control-sm mb-2" name="server_id" placeholder="Server ID (optional)">
        <textarea class="form-control form-control-sm mb-2" name="options" rows="3" placeholder="One map_key per line"></textarea>
        <button class="btn btn-success btn-sm">Start vote</button>
      </form>

      <h5>Recent votes</h5>
      <table class="table table-sm">
        <thead><tr><th>Vote</th><th>Status</th><th>Winner</th><th></th></tr></thead>
        <tbody>
          <% votes.forEach(function(v){ %>
            <tr><td><%= v.vote_id %></td><td><%= v.status %></td><td><%= v.winning_map_key || '—' %></td>
              <td>
                <% if (v.status === 'active') { %>
                  <button class="btn btn-sm btn-outline-primary end-vote" data-id="<%= v.vote_id %>">End</button>
                  <button class="btn btn-sm btn-outline-danger cancel-vote" data-id="<%= v.vote_id %>">Cancel</button>
                <% } %>
              </td></tr>
          <% }) %>
          <% if (!votes.length) { %><tr><td colspan="4" class="text-muted text-center">No votes yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div></div></div>

<script>
  const alertEl = document.getElementById('mixedAlert');
  function notify(ok,msg){ alertEl.className='alert alert-'+(ok?'success':'danger'); alertEl.textContent=msg; alertEl.classList.remove('d-none'); }
  document.getElementById('settingsForm').addEventListener('submit', async function(e){
    e.preventDefault(); const fd = new FormData(this); const body = {};
    ['vote_duration_seconds','vote_options_count','map_cooldown_minutes','player_cooldown_minutes','token_nominate_cost','token_set_next_cost','token_sponsor_cost','token_boost_weight'].forEach(k=>body[k]=Number(fd.get(k)));
    body.allow_web_voting = this.allow_web_voting.checked ? 1 : 0;
    body.public_feedback_enabled = this.public_feedback_enabled.checked ? 1 : 0;
    const r = await fetch('/api/admin/mixed/voting/settings', { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json(); notify(j.success, j.success?'Settings saved.':(j.message||'Failed'));
  });
  document.getElementById('startVoteForm').addEventListener('submit', async function(e){
    e.preventDefault(); const fd = new FormData(this);
    const options = (fd.get('options')||'').split('\n').map(s=>s.trim()).filter(Boolean).map(k=>({ map_key:k }));
    const r = await fetch('/api/admin/mixed/votes/start', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ vote_id: fd.get('vote_id'), server_id: fd.get('server_id')||null, options }) });
    const j = await r.json(); notify(j.success, j.success?'Vote started.':(j.message||'Failed')); if (j.success) setTimeout(()=>location.reload(),800);
  });
  document.querySelectorAll('.end-vote').forEach(b=>b.addEventListener('click', async()=>{ const r=await fetch('/api/admin/mixed/votes/'+b.dataset.id+'/end',{method:'POST'}); const j=await r.json(); notify(j.success,j.success?'Ended.':j.message); if(j.success)setTimeout(()=>location.reload(),600); }));
  document.querySelectorAll('.cancel-vote').forEach(b=>b.addEventListener('click', async()=>{ const r=await fetch('/api/admin/mixed/votes/'+b.dataset.id+'/cancel',{method:'POST'}); const j=await r.json(); notify(j.success,j.success?'Cancelled.':j.message); if(j.success)setTimeout(()=>location.reload(),600); }));
</script>

<%- include("../../admin/_footer.ejs") %>
