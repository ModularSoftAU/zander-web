<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Map Tokens</h1>
  </div>

  <div id="mixedAlert" class="alert d-none"></div>

  <div class="row g-4">
    <div class="col-lg-5">
      <h5>Grant / remove tokens</h5>
      <form id="grantForm" class="mb-4">
        <div class="mb-2">
          <label class="form-label form-label-sm mb-1">Linked username</label>
          <div class="position-relative">
            <input class="form-control form-control-sm" id="tokenUserSearch" name="username" placeholder="Start typing a username" autocomplete="off" required>
            <div id="tokenUserSuggestions" class="list-group position-absolute w-100 shadow-sm" style="z-index:1000;display:none;max-height:220px;overflow-y:auto;top:100%;"></div>
          </div>
          <input type="hidden" id="tokenUserId" name="user_id">
          <div class="form-text">Only website users with a linked Minecraft account can use map tokens.</div>
        </div>
        <div id="tokenUserCard" class="d-none mb-2">
          <div class="d-flex align-items-center gap-3 p-2 border rounded bg-light">
            <img id="tokenUserAvatar" src="" alt="" style="width:36px;height:36px;border-radius:4px;">
            <div>
              <div class="fw-semibold" id="tokenUserName"></div>
              <div class="text-muted small">Linked account selected</div>
            </div>
          </div>
        </div>
        <input type="number" class="form-control form-control-sm mb-2" name="amount" placeholder="Amount" min="1" required>
        <input class="form-control form-control-sm mb-2" name="reason" placeholder="Reason">
        <button class="btn btn-success btn-sm" data-op="grant">Grant</button>
        <button class="btn btn-danger btn-sm" data-op="remove">Remove</button>
      </form>

      <h6>Pending map requests</h6>
      <table class="table table-sm">
        <thead><tr><th>Player</th><th>Map</th><th>Action</th><th></th></tr></thead>
        <tbody>
          <% pending.forEach(function(r){ %>
            <tr><td class="small"><%= r.username || r.player_uuid %></td><td><%= r.map_key %></td><td><%= r.action_type %></td>
              <td><button class="btn btn-sm btn-outline-warning refund" data-id="<%= r.id %>">Refund</button></td></tr>
          <% }) %>
          <% if (!pending.length) { %><tr><td colspan="4" class="text-muted text-center">None.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="col-lg-7">
      <form class="row g-2 mb-2" method="get">
        <div class="col-md-6"><input class="form-control form-control-sm" name="search" placeholder="Search balances" value="<%= query.search || '' %>"></div>
        <div class="col-md-2"><button class="btn btn-sm btn-primary">Search</button></div>
      </form>
      <h5>Balances</h5>
      <table class="table table-sm">
        <thead><tr><th>Player</th><th>Balance</th><th>Earned</th><th>Spent</th></tr></thead>
        <tbody>
          <% balances.forEach(function(b){ %>
            <tr><td class="small"><%= b.username || b.player_uuid %></td><td><%= b.balance %></td><td><%= b.lifetime_earned %></td><td><%= b.lifetime_spent %></td></tr>
          <% }) %>
          <% if (!balances.length) { %><tr><td colspan="4" class="text-muted text-center">No balances.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div></div></div>

<script>
  const alertEl = document.getElementById('mixedAlert');
  function notify(ok,msg){ alertEl.className='alert alert-'+(ok?'success':'danger'); alertEl.textContent=msg; alertEl.classList.remove('d-none'); }

  (function initUserAutocomplete(){
    const searchEl = document.getElementById('tokenUserSearch');
    const suggestionsEl = document.getElementById('tokenUserSuggestions');
    const userIdEl = document.getElementById('tokenUserId');
    const userCardEl = document.getElementById('tokenUserCard');
    const userAvatarEl = document.getElementById('tokenUserAvatar');
    const userNameEl = document.getElementById('tokenUserName');
    let timer = null;

    function clearSuggestions() {
      suggestionsEl.innerHTML = '';
      suggestionsEl.style.display = 'none';
    }

    function selectUser(user) {
      searchEl.value = user.username;
      userIdEl.value = user.userId;
      userAvatarEl.src = user.avatarUrl || '';
      userNameEl.textContent = user.username;
      userCardEl.classList.remove('d-none');
      clearSuggestions();
    }

    function renderSuggestions(results) {
      clearSuggestions();
      if (!results.length) return;
      results.forEach((user) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 px-2';
        if (user.avatarUrl) {
          const img = document.createElement('img');
          img.src = user.avatarUrl;
          img.alt = '';
          img.width = 28;
          img.height = 28;
          img.className = 'rounded';
          btn.appendChild(img);
        }
        const text = document.createElement('span');
        text.className = 'flex-fill text-start small';
        text.textContent = user.username;
        btn.appendChild(text);
        btn.addEventListener('click', function(){ selectUser(user); });
        suggestionsEl.appendChild(btn);
      });
      suggestionsEl.style.display = 'block';
    }

    async function doSearch(term) {
      if (!term || term.length < 2) {
        clearSuggestions();
        return;
      }
      try {
        const response = await fetch('/dashboard/mixed/user-search?q=' + encodeURIComponent(term), { credentials: 'include' });
        const data = await response.json();
        renderSuggestions(data.results || []);
      } catch (_error) {
        clearSuggestions();
      }
    }

    searchEl.addEventListener('input', function(e) {
      userIdEl.value = '';
      userCardEl.classList.add('d-none');
      clearTimeout(timer);
      timer = setTimeout(function(){ doSearch(e.target.value.trim()); }, 200);
    });

    document.addEventListener('click', function(e) {
      if (!searchEl.contains(e.target) && !suggestionsEl.contains(e.target)) clearSuggestions();
    });
  })();

  document.querySelectorAll('#grantForm button').forEach(function(btn){
    btn.addEventListener('click', async function(e){
      e.preventDefault();
      const f = document.getElementById('grantForm');
      const body = { user_id: Number(f.user_id.value), username: f.username.value.trim(), amount: Number(f.amount.value), reason: f.reason.value.trim() };
      if (!body.user_id) {
        notify(false, 'Select a linked username from the dropdown first.');
        return;
      }
      const r = await fetch('/api/admin/mixed/map-tokens/'+btn.dataset.op, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      const j = await r.json(); notify(j.success, j.success?('New balance: '+j.data.balance):(j.message||'Failed')); if(j.success)setTimeout(()=>location.reload(),900);
    });
  });
  document.querySelectorAll('.refund').forEach(b=>b.addEventListener('click', async()=>{ const r=await fetch('/api/admin/mixed/map-requests/'+b.dataset.id+'/refund',{method:'POST'}); const j=await r.json(); notify(j.success,j.success?'Refunded.':j.message); if(j.success)setTimeout(()=>location.reload(),600); }));
</script>

<%- include("../../admin/_footer.ejs") %>
