<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Maps</h1>
  </div>

  <div id="mixedAlert" class="alert d-none"></div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Map repo sync</strong>
      <button id="syncAllBtn" class="btn btn-sm btn-primary">Sync all repos</button>
    </div>
    <div class="card-body">
      <% if (!sourcesInfo.enabled) { %>
        <div class="alert alert-warning mb-0">
          Map sync is disabled (<code>mixed.mapSync.enabled = false</code> in <code>config.json</code>).
          Until you enable it and run a sync, the public maps page will only show rows created by Mixed ingestion such as
          <code>/api/mixed/stats/map</code> or match placeholders from <code>/api/mixed/stats/match</code>.
        </div>
      <% } else { %>
      <div class="table-responsive"><table class="table table-sm align-middle">
        <thead><tr>
          <th>Source</th><th>Repo</th><th>Branch</th><th>Priority</th><th>Enabled</th>
          <th>Last status</th><th>Commit</th><th>Found/Created/Updated/Skipped</th><th>Conflicts</th><th></th>
        </tr></thead>
        <tbody>
          <% sourcesInfo.sources.forEach(function(s){
               const run = (latestRuns || []).find(function(r){ return r.source_key === s.sourceKey; });
          %>
            <tr>
              <td><strong><%= s.displayName %></strong><br><code class="small"><%= s.sourceKey %></code></td>
              <td><%= sourcesInfo.githubOrg %>/<%= s.repo %></td>
              <td><%= s.branch %></td>
              <td><%= s.priority %></td>
              <td><%= s.enabled ? 'Yes' : 'No' %></td>
              <td><%= run ? run.status : '—' %></td>
              <td><code class="small"><%= run && run.source_commit ? run.source_commit.slice(0,8) : '—' %></code></td>
              <td><%= run ? `${run.maps_found}/${run.maps_created}/${run.maps_updated}/${run.maps_skipped}` : '—' %></td>
              <td><%= run ? run.conflicts_found : '—' %></td>
              <td><button class="btn btn-sm btn-outline-secondary sync-one" data-source="<%= s.sourceKey %>">Sync</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  </div>

  <% if ((conflicts || []).length) { %>
  <div class="card mb-4 border-warning">
    <div class="card-header"><strong>Duplicate map key conflicts</strong></div>
    <div class="card-body">
      <ul class="list-group list-group-flush">
        <% conflicts.forEach(function(c){ %>
          <li class="list-group-item"><strong><%= c.map_key %></strong> — <%= c.last_sync_error %></li>
        <% }) %>
      </ul>
    </div>
  </div>
  <% } %>

  <% if ((placeholders || []).length) { %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Placeholder maps (discovered from server)</strong>
      <button id="purgeAllPlaceholdersBtn" class="btn btn-sm btn-outline-danger">Remove all placeholders</button>
    </div>
    <div class="card-body">
      <ul class="list-group list-group-flush">
        <% placeholders.forEach(function(p){ %>
          <li class="list-group-item d-flex justify-content-between align-items-center" data-placeholder-map="<%= p.map_key %>">
            <span><%= p.name %> <code class="small"><%= p.map_key %></code></span>
            <span class="d-flex align-items-center gap-3">
              <span class="text-muted small">first seen <%= moment(p.first_seen_at).fromNow() %></span>
              <button class="btn btn-sm btn-outline-danger purge-one-placeholder" data-map="<%= p.map_key %>">Remove</button>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
  <% } %>

  <form class="row g-2 mb-3" method="get">
    <div class="col-md-4"><input class="form-control form-control-sm" name="search" placeholder="Search maps" value="<%= query.search || '' %>"></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary">Search</button></div>
  </form>

  <div class="table-responsive"><table class="table table-sm align-middle">
    <thead><tr><th>Map</th><th>Gamemode</th><th>Source</th><th>Visible</th><th>Voting</th><th>Tokens</th><th>Actions</th></tr></thead>
    <tbody>
      <% result.maps.forEach(function(m){ %>
        <tr data-map="<%= m.map_key %>">
          <td><strong><%= m.name %></strong><br><code class="small"><%= m.map_key %></code></td>
          <td><%= m.gamemode || '—' %></td>
          <td>
            <% if (m.discovered_from_server) { %><span class="badge bg-secondary">Placeholder</span>
            <% } else if (m.source_key) { %><%= m.source_display_name || m.source_key %>
            <% } else { %>—<% } %>
          </td>
          <td><input type="checkbox" class="toggle" data-field="public_visible" <%= m.public_visible?'checked':'' %>></td>
          <td><input type="checkbox" class="toggle" data-field="blacklisted_from_voting" <%= m.blacklisted_from_voting?'checked':'' %>> <small>blacklist</small></td>
          <td><input type="checkbox" class="toggle" data-field="blacklisted_from_tokens" <%= m.blacklisted_from_tokens?'checked':'' %>> <small>blacklist</small></td>
          <td>
            <button class="btn btn-sm btn-outline-secondary edit-thumb">Thumbnail</button>
            <button class="btn btn-sm btn-outline-danger reset-ratings">Reset ratings</button>
          </td>
        </tr>
      <% }) %>
      <% if (!result.maps.length) { %><tr><td colspan="7" class="text-muted text-center">No maps.</td></tr><% } %>
    </tbody>
  </table></div>
</div></div></div>

<script>
  const alertEl = document.getElementById('mixedAlert');
  function notify(ok, msg){ alertEl.className = 'alert alert-'+(ok?'success':'danger'); alertEl.textContent = msg; alertEl.classList.remove('d-none'); setTimeout(()=>alertEl.classList.add('d-none'), 3000); }
  async function patchMap(mapKey, body){
    const r = await fetch('/api/admin/mixed/maps/'+encodeURIComponent(mapKey), { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    return r.json();
  }
  document.querySelectorAll('.toggle').forEach(function(cb){
    cb.addEventListener('change', async function(){
      const key = cb.closest('tr').dataset.map;
      const j = await patchMap(key, { [cb.dataset.field]: cb.checked ? 1 : 0 });
      notify(j.success, j.success ? 'Saved.' : (j.message||'Failed'));
    });
  });
  document.querySelectorAll('.edit-thumb').forEach(function(b){
    b.addEventListener('click', async function(){
      const key = b.closest('tr').dataset.map;
      const url = prompt('Thumbnail URL:');
      if (url === null) return;
      const r = await fetch('/api/admin/mixed/maps/'+encodeURIComponent(key)+'/thumbnail', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ thumbnail_url: url }) });
      const j = await r.json(); notify(j.success, j.success?'Thumbnail saved.':(j.message||'Failed'));
    });
  });
  document.querySelectorAll('.reset-ratings').forEach(function(b){
    b.addEventListener('click', async function(){
      const key = b.closest('tr').dataset.map;
      if (!confirm('Reset all ratings for '+key+'?')) return;
      const r = await fetch('/api/admin/mixed/maps/'+encodeURIComponent(key)+'/ratings/reset', { method:'POST' });
      const j = await r.json(); notify(j.success, j.success?'Ratings reset.':(j.message||'Failed'));
    });
  });

  document.querySelectorAll('.purge-one-placeholder').forEach(function(b){
    b.addEventListener('click', async function(){
      const key = b.dataset.map;
      if (!confirm('Remove placeholder map "'+key+'"? This does not affect match history.')) return;
      const r = await fetch('/api/admin/mixed/maps/placeholders/purge', {
        method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ mapKeys: [key] }),
      });
      const j = await r.json();
      notify(j.success, j.success ? 'Placeholder removed.' : (j.message || 'Failed'));
      if (j.success) setTimeout(() => location.reload(), 800);
    });
  });

  document.getElementById('purgeAllPlaceholdersBtn')?.addEventListener('click', async function(){
    if (!confirm('Remove ALL placeholder maps? This does not affect match history.')) return;
    this.disabled = true; this.textContent = 'Removing…';
    try {
      const r = await fetch('/api/admin/mixed/maps/placeholders/purge', { method: 'POST' });
      const j = await r.json();
      notify(j.success, j.success ? `Removed ${j.data.deleted} placeholder map(s).` : (j.message || 'Failed'));
      if (j.success) setTimeout(() => location.reload(), 800);
    } finally {
      this.disabled = false; this.textContent = 'Remove all placeholders';
    }
  });

  document.getElementById('syncAllBtn')?.addEventListener('click', async function(){
    this.disabled = true; this.textContent = 'Syncing…';
    try {
      const r = await fetch('/api/admin/mixed/maps/sync', { method: 'POST' });
      const j = await r.json();
      notify(j.success, j.success ? `Sync complete: ${JSON.stringify(j.data.summary)}` : (j.message || 'Sync failed'));
      if (j.success) setTimeout(() => location.reload(), 1500);
    } finally {
      this.disabled = false; this.textContent = 'Sync all repos';
    }
  });

  document.querySelectorAll('.sync-one').forEach(function(b){
    b.addEventListener('click', async function(){
      const sourceKey = b.dataset.source;
      b.disabled = true; b.textContent = 'Syncing…';
      try {
        const r = await fetch('/api/admin/mixed/maps/sync/' + encodeURIComponent(sourceKey), { method: 'POST' });
        const j = await r.json();
        notify(j.success, j.success ? `Synced ${sourceKey}: ${JSON.stringify(j.data.counts)}` : (j.message || 'Sync failed'));
        if (j.success) setTimeout(() => location.reload(), 1500);
      } finally {
        b.disabled = false; b.textContent = 'Sync';
      }
    });
  });
</script>

<%- include("../../admin/_footer.ejs") %>
