<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Entitlements</h1>
  </div>
  <p class="text-muted small">Entitlement management only — chat-tag entitlements are intentionally excluded.</p>

  <div id="mixedAlert" class="alert d-none"></div>

  <form class="row g-2 mb-3" method="get">
    <div class="col-md-5"><input class="form-control form-control-sm" name="uuid" placeholder="Player UUID" value="<%= query.uuid || '' %>"></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary">Lookup</button></div>
  </form>

  <% if (lookupUuid) { %>
    <h5>Entitlements for <code><%= lookupUuid %></code></h5>
    <table class="table table-sm align-middle">
      <thead><tr><th>Entitlement</th><th>Expires</th><th>Sync</th><th></th></tr></thead>
      <tbody>
        <% entitlements.forEach(function(e){ %>
          <tr><td><%= e.display_name || e.entitlement_key %></td>
            <td class="small"><%= e.expires_at ? moment(e.expires_at).format('YYYY-MM-DD') : '—' %></td>
            <td><span class="badge <%= e.sync_status==='synced'?'bg-success':'bg-secondary' %>"><%= e.sync_status %></span></td>
            <td><button class="btn btn-sm btn-outline-danger del-ent" data-id="<%= e.id %>">Remove</button></td></tr>
        <% }) %>
        <% if (!entitlements.length) { %><tr><td colspan="4" class="text-muted text-center">No entitlements.</td></tr><% } %>
      </tbody>
    </table>

    <h6 class="mt-4">Add entitlement</h6>
    <form id="addForm" class="row g-2">
      <div class="col-md-4"><input class="form-control form-control-sm" name="entitlement_key" placeholder="entitlement_key" required></div>
      <div class="col-md-3"><input type="date" class="form-control form-control-sm" name="expires_at"></div>
      <div class="col-md-2"><button class="btn btn-sm btn-success">Add</button></div>
    </form>
  <% } %>
</div></div></div>

<script>
  const alertEl = document.getElementById('mixedAlert');
  const lookupUuid = <%- JSON.stringify(lookupUuid || null) %>;
  function notify(ok,msg){ alertEl.className='alert alert-'+(ok?'success':'danger'); alertEl.textContent=msg; alertEl.classList.remove('d-none'); }
  const addForm = document.getElementById('addForm');
  if (addForm) addForm.addEventListener('submit', async function(e){
    e.preventDefault();
    const body = { entitlement_key: this.entitlement_key.value.trim(), expires_at: this.expires_at.value || null };
    const r = await fetch('/api/admin/mixed/entitlements/'+lookupUuid, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json(); notify(j.success, j.success?'Added.':(j.message||'Failed')); if(j.success)setTimeout(()=>location.reload(),700);
  });
  document.querySelectorAll('.del-ent').forEach(b=>b.addEventListener('click', async()=>{
    const r = await fetch('/api/admin/mixed/entitlements/'+lookupUuid+'/'+b.dataset.id, { method:'DELETE' });
    const j = await r.json(); notify(j.success, j.success?'Removed.':j.message); if(j.success)setTimeout(()=>location.reload(),600);
  }));
</script>

<%- include("../../admin/_footer.ejs") %>
