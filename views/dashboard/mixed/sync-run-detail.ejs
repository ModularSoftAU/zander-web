<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Map Sync Run</h1>
    <a href="/dashboard/mixed/maps" class="btn btn-sm btn-outline-secondary">Back to maps</a>
  </div>

  <% if (!run) { %>
    <div class="alert alert-warning">Sync run not found.</div>
  <% } else { %>
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3"><strong>Source</strong><br><%= run.source_display_name || run.source_key %></div>
          <div class="col-md-3"><strong>Status</strong><br><%= run.status %></div>
          <div class="col-md-3"><strong>Commit</strong><br><code class="small"><%= run.source_commit || '—' %></code></div>
          <div class="col-md-3"><strong>Triggered by</strong><br><%= run.triggered_by || '—' %></div>
          <div class="col-md-3"><strong>Found</strong><br><%= run.maps_found %></div>
          <div class="col-md-3"><strong>Created</strong><br><%= run.maps_created %></div>
          <div class="col-md-3"><strong>Updated</strong><br><%= run.maps_updated %></div>
          <div class="col-md-3"><strong>Skipped</strong><br><%= run.maps_skipped %></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><strong>Errors</strong></div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0">
        <thead><tr><th>Map</th><th>Type</th><th>Message</th><th>Path</th></tr></thead>
        <tbody>
          <% (errors || []).forEach(function(e){ %>
            <tr>
              <td><code class="small"><%= e.map_key || '—' %></code></td>
              <td><span class="badge bg-danger"><%= e.error_type %></span></td>
              <td><%= e.error_message %></td>
              <td><code class="small"><%= e.source_path || '—' %></code></td>
            </tr>
          <% }) %>
          <% if (!(errors || []).length) { %><tr><td colspan="4" class="text-muted text-center">No errors.</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
  <% } %>
</div></div></div>

<%- include("../../admin/_footer.ejs") %>
