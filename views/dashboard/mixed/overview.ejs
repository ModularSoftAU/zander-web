<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Mixed Overview</h1>
    <a href="/mixed" class="btn btn-sm btn-outline-secondary" target="_blank">View public portal ↗</a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="h3 mb-0"><%= overview.servers.filter(s=>s.online).length %>/<%= overview.servers.length %></div><small class="text-muted">Servers online</small></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="h3 mb-0"><%= overview.pendingRequests %></div><small class="text-muted">Queued map requests</small></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="h3 mb-0 text-danger"><%= overview.failedRequests %></div><small class="text-muted">Failed requests</small></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="h3 mb-0"><%= overview.recentTransactions.length %></div><small class="text-muted">Recent token txns</small></div></div></div>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <h5>Connected servers</h5>
      <table class="table table-sm">
        <thead><tr><th>Server</th><th>Status</th><th>Map</th><th>Heartbeat</th></tr></thead>
        <tbody>
          <% overview.servers.forEach(function(s){ %>
            <tr><td><%= s.display_name %></td>
              <td><span class="badge <%= s.online?'bg-success':'bg-secondary' %>"><%= s.online?'Online':'Offline' %></span></td>
              <td><%= s.current_map_name || '—' %></td>
              <td class="small text-muted"><%= s.last_heartbeat_at ? moment(s.last_heartbeat_at).fromNow() : '—' %></td>
            </tr>
          <% }) %>
          <% if (!overview.servers.length) { %><tr><td colspan="4" class="text-muted text-center">No servers reporting.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    <div class="col-lg-6">
      <h5>Latest matches</h5>
      <table class="table table-sm">
        <thead><tr><th>Map</th><th>Status</th><th>Started</th></tr></thead>
        <tbody>
          <% overview.recentMatches.forEach(function(m){ %>
            <tr><td><a href="/mixed/matches/<%= m.match_id %>" target="_blank"><%= m.map_name || m.map_key || m.match_id %></a></td>
              <td><%= m.status %></td>
              <td class="small text-muted"><%= m.started_at ? moment(m.started_at).fromNow() : '—' %></td></tr>
          <% }) %>
          <% if (!overview.recentMatches.length) { %><tr><td colspan="3" class="text-muted text-center">No matches yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div></div></div>

<%- include("../../admin/_footer.ejs") %>
