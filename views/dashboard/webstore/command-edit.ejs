<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-pencil fa-fw me-2"></i>Edit Command</h1>
        <a href="/dashboard/webstore/commands" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Commands
        </a>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="row justify-content-center">
        <div class="col-lg-7">

          <div class="card shadow-sm mb-3">
            <div class="card-header">
              <span class="text-muted small">Package</span>
              <% if (command.packageName) { %>
                <strong class="ms-2"><%= command.packageName %></strong>
              <% } %>
              <% if (command.stripePriceId) { %>
                <code class="ms-2 small text-muted"><%= command.stripePriceId %></code>
              <% } %>
            </div>
          </div>

          <div class="card shadow-sm">
            <div class="card-body">
              <form method="post" action="/dashboard/webstore/commands/<%= command.commandId %>/edit">

                <div class="mb-3">
                  <label for="action" class="form-label fw-semibold">Action <span class="text-danger">*</span></label>
                  <select class="form-select" id="action" name="action" required>
                    <option value="grant" <%= command.action === 'grant' ? 'selected' : '' %>>grant — run when purchased / subscription renews</option>
                    <option value="revoke" <%= command.action === 'revoke' ? 'selected' : '' %>>revoke — run when subscription is cancelled / expires</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="commandType" class="form-label fw-semibold">Command Type <span class="text-danger">*</span></label>
                  <select class="form-select" id="commandType" name="commandType">
                    <option value="minecraft" <%= (command.commandType || 'minecraft') === 'minecraft' ? 'selected' : '' %>>Minecraft</option>
                    <option value="discord_role" <%= command.commandType === 'discord_role' ? 'selected' : '' %>>Discord role</option>
                  </select>
                  <div class="form-text">
                    <strong>Minecraft</strong> — sends a console command to the Minecraft server (supports <code>{{ username }}</code> etc.).
                    <br>
                    <strong>Discord role</strong> — adds or removes a Discord role from the recipient's linked account; the template field should be the bare Discord role ID.
                  </div>
                </div>

                <div class="mb-3">
                  <label for="commandTemplate" class="form-label fw-semibold">Command / Role ID <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="commandTemplate" name="commandTemplate"
                         required maxlength="1000"
                         value="<%= command.commandTemplate %>">
                  <div class="form-text">
                    Minecraft console command — supports <code>{{ username }}</code>, <code>{{ purchaserUsername }}</code>, <code>{{ purchaseId }}</code>, <code>{{ itemSlug }}</code>, <code>{{ purchaseType }}</code>, <code>{{ isGift }}</code>.
                    <br>
                    For <strong>Discord role</strong> type: paste the Discord role ID (right-click the role in Discord &rsaquo; Copy ID).
                  </div>
                </div>

                <div class="mb-4">
                  <label for="sortOrder" class="form-label fw-semibold">Sort Order</label>
                  <input type="number" class="form-control" id="sortOrder" name="sortOrder"
                         value="<%= command.sortOrder %>" min="0" style="max-width:140px;">
                  <div class="form-text">Commands with a lower sort order run first.</div>
                </div>

                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check me-1"></i>Save Changes
                  </button>
                  <a href="/dashboard/webstore/commands" class="btn btn-outline-secondary">Cancel</a>
                </div>

              </form>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
