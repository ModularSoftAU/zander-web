<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-terminal fa-fw me-2"></i>Webstore — Command Config</h1>
        <a href="/dashboard/webstore" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Purchases
        </a>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="alert alert-info mb-4">
        <p class="mb-2">
          Products and prices are managed in the <a href="https://dashboard.stripe.com/products" target="_blank" rel="noopener">Stripe dashboard</a>.
          Commands below run when a Stripe price is purchased (<strong>grant</strong>) or a subscription is cancelled (<strong>revoke</strong>).
        </p>
        <p class="mb-0">
          Insert rows into <code>webstoreStripeCommands</code> to configure them.
          Each package can have any combination of <strong>Minecraft</strong> commands and <strong>Discord role</strong> actions — they all run at purchase/revoke time.
        </p>
      </div>

      <% if (!commands || !commands.length) { %>
        <div class="alert alert-warning">
          No commands configured. Insert rows into <code>webstoreStripeCommands</code> to map Stripe price IDs to grant/revoke actions.
        </div>
      <% } else { %>
        <%
          const byPrice = {};
          commands.forEach(function(cmd) {
            if (!byPrice[cmd.stripePriceId]) byPrice[cmd.stripePriceId] = [];
            byPrice[cmd.stripePriceId].push(cmd);
          });
        %>
        <% Object.entries(byPrice).forEach(function([priceId, cmds]) { %>
          <div class="card shadow-sm mb-3">
            <div class="card-header">
              <code class="small"><%= priceId %></code>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width:90px">Action</th>
                    <th style="width:120px">Type</th>
                    <th style="width:60px">Order</th>
                    <th>Command / Role ID</th>
                  </tr>
                </thead>
                <tbody>
                  <% cmds.forEach(function(cmd) {
                    const isDiscord = cmd.commandType === 'discord_role';
                  %>
                    <tr>
                      <td>
                        <span class="badge <%= cmd.action === 'grant' ? 'bg-success' : 'bg-danger' %>">
                          <%= cmd.action %>
                        </span>
                      </td>
                      <td>
                        <% if (isDiscord) { %>
                          <span class="badge bg-primary bg-opacity-75"><i class="fa-brands fa-discord me-1"></i>Discord role</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><i class="fa-solid fa-cubes me-1"></i>Minecraft</span>
                        <% } %>
                      </td>
                      <td class="text-muted"><%= cmd.sortOrder %></td>
                      <td>
                        <code class="small"><%= cmd.commandTemplate %></code>
                        <% if (isDiscord) { %>
                          <span class="text-muted small ms-1">← Discord role ID</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
      <% } %>

      <%# ── Reference cards ─────────────────────────────────────────────── %>
      <div class="row g-4 mt-1">

        <%# Minecraft commands %>
        <div class="col-lg-6">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">
              <i class="fa-solid fa-cubes fa-fw me-1 text-secondary"></i>Minecraft commands
            </div>
            <div class="card-body">
              <p class="text-muted small mb-3">
                Set <code>commandType = 'minecraft'</code> (or omit — it's the default).
                The template is sent to the Minecraft server console via the executor queue and runs even if the player is offline.
              </p>
              <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Placeholder</th><th>Replaced with</th></tr></thead>
                <tbody>
                  <tr><td><code>{{ username }}</code></td><td>Recipient's Minecraft username</td></tr>
                  <tr><td><code>{{ purchaserUsername }}</code></td><td>Purchaser's Minecraft username</td></tr>
                  <tr><td><code>{{ purchaseId }}</code></td><td>Internal purchase ID</td></tr>
                  <tr><td><code>{{ itemSlug }}</code></td><td>Stripe price ID</td></tr>
                  <tr><td><code>{{ purchaseType }}</code></td><td><code>one_time</code> or <code>subscription</code></td></tr>
                  <tr><td><code>{{ isGift }}</code></td><td><code>true</code> or <code>false</code></td></tr>
                </tbody>
              </table>
              <div class="mt-3 p-2 bg-light rounded small">
                <strong>Example rows:</strong>
                <pre class="mb-0 mt-1" style="font-size:0.78rem;">INSERT INTO webstoreStripeCommands
  (stripePriceId, action, commandType, commandTemplate, sortOrder)
VALUES
  ('price_xxx', 'grant', 'minecraft',
   'lp user {{ username }} parent add vip', 1),
  ('price_xxx', 'revoke', 'minecraft',
   'lp user {{ username }} parent remove vip', 1);</pre>
              </div>
            </div>
          </div>
        </div>

        <%# Discord role actions %>
        <div class="col-lg-6">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">
              <i class="fa-brands fa-discord fa-fw me-1 text-primary"></i>Discord role actions
            </div>
            <div class="card-body">
              <p class="text-muted small mb-3">
                Set <code>commandType = 'discord_role'</code>.
                The <code>commandTemplate</code> is a Discord <strong>role ID</strong> (not a name).
                On grant the role is added; on revoke it's removed.
                The recipient must have their Discord account linked in their profile — unlinked users are skipped with a logged warning.
              </p>
              <ul class="small text-muted ps-3 mb-3">
                <li>Enable Developer Mode in Discord → right-click the role → <em>Copy Role ID</em></li>
                <li>Placeholders are <strong>not</strong> substituted for Discord role rows — the template is the bare role ID</li>
                <li>Runs immediately at purchase/revocation time (not queued)</li>
              </ul>
              <div class="p-2 bg-light rounded small">
                <strong>Example rows:</strong>
                <pre class="mb-0 mt-1" style="font-size:0.78rem;">INSERT INTO webstoreStripeCommands
  (stripePriceId, action, commandType, commandTemplate, sortOrder)
VALUES
  ('price_xxx', 'grant', 'discord_role',
   '123456789012345678', 2),
  ('price_xxx', 'revoke', 'discord_role',
   '123456789012345678', 2);</pre>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
