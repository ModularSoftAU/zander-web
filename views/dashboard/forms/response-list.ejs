<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div>
          <h1 class="h2"><%= form.name %></h1>
          <small class="text-muted">
            Total: <strong><%= counts.total %></strong> |
            New: <strong><%= counts.newCount %></strong> |
            Converted: <strong><%= counts.convertedCount %></strong>
          </small>
        </div>
        <div class="btn-toolbar mb-2 mb-md-0">
          <a href="/dashboard/forms" class="btn btn-sm btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-1"></i> Back to Forms
          </a>
          <a href="/dashboard/forms/edit?formId=<%= form.formId %>" class="btn btn-sm btn-warning">Edit Form</a>
        </div>
      </div>
      <%- include("../../admin/_notices.ejs") %>

      <!-- Top-level tabs: Responses | Summary -->
      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-responses" type="button" role="tab">
            <i class="fas fa-list me-1"></i>Responses
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-summary" type="button" role="tab">
            <i class="fas fa-chart-bar me-1"></i>Summary
          </button>
        </li>
      </ul>

      <div class="tab-content">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Responses (existing table view)           -->
        <!-- ═══════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="tab-responses" role="tabpanel">

          <!-- Filters -->
          <div class="mb-3">
            <div class="btn-group btn-group-sm" role="group">
              <a href="/dashboard/forms/<%= form.formId %>/responses" class="btn btn-outline-primary <%= !statusFilter ? 'active' : '' %>">All</a>
              <a href="/dashboard/forms/<%= form.formId %>/responses?status=new" class="btn btn-outline-primary <%= statusFilter === 'new' ? 'active' : '' %>">New</a>
              <a href="/dashboard/forms/<%= form.formId %>/responses?status=reviewed" class="btn btn-outline-primary <%= statusFilter === 'reviewed' ? 'active' : '' %>">Reviewed</a>
              <a href="/dashboard/forms/<%= form.formId %>/responses?status=converted" class="btn btn-outline-primary <%= statusFilter === 'converted' ? 'active' : '' %>">Converted</a>
              <a href="/dashboard/forms/<%= form.formId %>/responses?status=archived" class="btn btn-outline-primary <%= statusFilter === 'archived' ? 'active' : '' %>">Archived</a>
            </div>
          </div>

          <% if (!responses || responses.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-inbox text-muted" style="font-size: 3rem;"></i>
              <p class="text-muted mt-3">No responses found<%= statusFilter ? ' with status "' + statusFilter + '"' : '' %>.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle response-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Submitter</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% responses.forEach(function(response) { %>
                    <tr>
                      <td><%= response.responseId %></td>
                      <td><%= response.submitterUsername || 'Anonymous' %></td>
                      <td><%= moment(response.submittedAt).fromNow() %></td>
                      <td>
                        <span class="badge bg-<%= response.status === 'new' ? 'primary' : response.status === 'reviewed' ? 'info' : response.status === 'converted' ? 'success' : 'secondary' %>">
                          <%= response.status %>
                        </span>
                        <% if (response.discordWebhookFailed) { %>
                          <span class="badge bg-warning text-dark" title="Discord webhook failed"><i class="fas fa-exclamation-triangle"></i></span>
                        <% } %>
                        <% if (response.discordForumPostFailed) { %>
                          <span class="badge bg-warning text-dark" title="Discord forum post failed"><i class="fas fa-exclamation-triangle"></i></span>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex flex-wrap gap-1">
                          <a href="/dashboard/forms/<%= form.formId %>/responses/<%= response.responseId %>" class="btn btn-sm btn-outline-primary">View</a>
                          <% if (response.status === 'new') { %>
                            <form action="<%= process.env.siteAddress %>/redirect/forms/response/status" method="post" style="display:inline;">
                              <input type="hidden" name="responseId" value="<%= response.responseId %>">
                              <input type="hidden" name="formId" value="<%= form.formId %>">
                              <input type="hidden" name="status" value="reviewed">
                              <button class="btn btn-sm btn-outline-info" type="submit">Mark Reviewed</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <% if (counts.total > limit) { %>
              <nav>
                <ul class="pagination pagination-sm justify-content-center">
                  <% var totalPages = Math.ceil(counts.total / limit); %>
                  <% for (var p = 1; p <= totalPages; p++) { %>
                    <li class="page-item <%= page === p ? 'active' : '' %>">
                      <a class="page-link" href="/dashboard/forms/<%= form.formId %>/responses?page=<%= p %><%= statusFilter ? '&status=' + statusFilter : '' %>"><%= p %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } %>

        </div><!-- /#tab-responses -->

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Summary                                   -->
        <!-- ═══════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="tab-summary" role="tabpanel">

          <% if (!summary || summary.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-chart-pie text-muted" style="font-size: 3rem;"></i>
              <p class="text-muted mt-3">No questions to summarise.</p>
            </div>
          <% } else { %>

            <!-- Sub-tabs: All Questions | individual questions -->
            <ul class="nav nav-pills nav-fill mb-3 flex-nowrap overflow-auto" id="summaryTabs" role="tablist" style="white-space:nowrap;">
              <li class="nav-item flex-shrink-0">
                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#sq-all" type="button" role="tab">All Questions</button>
              </li>
              <% summary.forEach(function(q, qi) { %>
                <li class="nav-item flex-shrink-0">
                  <button class="nav-link" data-bs-toggle="pill" data-bs-target="#sq-<%= qi %>" type="button" role="tab" title="<%= q.label %>">
                    Q<%= qi + 1 %>
                  </button>
                </li>
              <% }) %>
            </ul>

            <div class="tab-content">

              <!-- All Questions overview -->
              <div class="tab-pane fade show active" id="sq-all" role="tabpanel">
                <% summary.forEach(function(q, qi) { %>
                  <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                      <span class="fw-semibold"><%= q.label %></span>
                      <span class="badge bg-secondary"><%= q.answered %> / <%= q.totalResponses %> answered</span>
                    </div>
                    <div class="card-body">
                      <%- include("../../partials/forms/summary-question.ejs", { q: q, chartPrefix: 'all' }) %>
                    </div>
                  </div>
                <% }) %>
              </div>

              <!-- Individual question tabs -->
              <% summary.forEach(function(q, qi) { %>
                <div class="tab-pane fade" id="sq-<%= qi %>" role="tabpanel">
                  <div class="card">
                    <div class="card-header">
                      <h5 class="mb-1"><%= q.label %></h5>
                      <small class="text-muted">
                        <span class="badge bg-secondary"><%= q.type.replace(/_/g, ' ') %></span>
                        &nbsp; <%= q.answered %> answered &middot; <%= q.skipped %> skipped
                      </small>
                    </div>
                    <div class="card-body">
                      <%- include("../../partials/forms/summary-question.ejs", { q: q, chartPrefix: 'ind' }) %>
                    </div>
                  </div>
                </div>
              <% }) %>

            </div><!-- /.tab-content (inner) -->

          <% } %>

        </div><!-- /#tab-summary -->

      </div><!-- /.tab-content (outer) -->

    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->
  <%- include("../../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->
<script>
document.querySelectorAll('[data-bs-toggle="tab"], [data-bs-toggle="pill"]').forEach(function(el) {
    el.addEventListener('shown.bs.tab', function() {
        if (typeof Chart === 'undefined') return;
        Object.values(Chart.instances || {}).forEach(function(c) { c.resize(); });
    });
});
</script>
