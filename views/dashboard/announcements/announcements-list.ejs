<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <!-- ── Page header ─────────────────────────────────────────────────── -->
      <div class="wp-admin-page-header">
        <h1 class="wp-heading-inline">Announcements</h1>
        <button type="button" class="page-title-action outline"
                data-bs-toggle="modal" data-bs-target="#announcementWizardModal">
          <i class="fas fa-clock" aria-hidden="true"></i> Schedule
        </button>
        <a href="/dashboard/announcements/create" class="page-title-action">
          <i class="fas fa-plus" aria-hidden="true"></i> Add New
        </a>
        <a href="https://modularsoft.org/docs/products/zander/features/announcement/"
           target="_blank" rel="noopener" class="page-title-action outline"
           title="Documentation">
          <i class="fas fa-book" aria-hidden="true"></i>
          <span class="d-none d-md-inline">Docs</span>
        </a>
      </div>
      <hr class="wp-section-divider">

      <%- include("../../admin/_notices.ejs") %>

      <!-- ── List table ──────────────────────────────────────────────────── -->
      <div class="wp-list-wrap">

        <!-- Table nav top -->
        <div class="tablenav">
          <div class="bulkactions">
            <label for="bulk-action-selector" class="visually-hidden">Select bulk action</label>
            <select id="bulk-action-selector" name="action">
              <option value="-1">Bulk actions</option>
            </select>
            <button type="submit" class="button" disabled>Apply</button>
          </div>
        </div>
        <!-- /tablenav top -->

        <div class="table-responsive">
          <table class="wp-list-table wp-list-table-responsive" aria-label="Announcements">
            <thead>
              <tr>
                <th scope="col">Type</th>
                <th scope="col">Content</th>
                <th scope="col">Schedule</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>

              <% if (!apiData || apiData.success === false) { %>
                <tr>
                  <td colspan="5">
                    <div class="wp-notice wp-notice-error" style="margin:0;">
                      <span class="wp-notice-icon"><i class="fas fa-times-circle"></i></span>
                      <p><%= apiData ? apiData.message : 'Failed to load announcements.' %></p>
                    </div>
                  </td>
                </tr>

              <% } else if (!apiData.data || apiData.data.length === 0) { %>
                <tr>
                  <td colspan="5">
                    <div class="wp-empty-state">
                      <i class="fas fa-bullhorn"></i>
                      <p>No announcements yet. <a href="/dashboard/announcements/create">Create the first one.</a></p>
                    </div>
                  </td>
                </tr>

              <% } else { %>
                <% for (const ann of apiData.data) {
                     const _now     = new Date();
                     const _end     = ann.endDate   ? new Date(ann.endDate)   : null;
                     const _start   = ann.startDate ? new Date(ann.startDate) : null;
                     const _expired = _end   && _end   < _now;
                     const _sched   = _start && _start > _now;
                     let _statusCls = (ann.enabled === true || ann.enabled === 1) ? 'active' : 'inactive';
                     if (_expired)   _statusCls = 'inactive';
                     if (_sched)     _statusCls = 'pending';
                     let _statusLbl = (ann.enabled === true || ann.enabled === 1) ? 'Active' : 'Disabled';
                     if (_expired)   _statusLbl = 'Expired';
                     if (_sched)     _statusLbl = 'Scheduled';
                %>
                  <tr>
                    <td data-label="Type">
                      <span class="wp-badge info"><%= ann.announcementType %></span>
                    </td>
                    <td data-label="Content" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                      <%= ann.colourMessageFormat || ann.body || '—' %>
                    </td>
                    <td data-label="Schedule">
                      <% if (ann.startDate || ann.endDate) { %>
                        <small class="text-muted-sm">
                          <span class="js-datetime" data-iso="<%= ann.startDate || '' %>" data-fallback="Now"></span>
                          →
                          <span class="js-datetime" data-iso="<%= ann.endDate || '' %>" data-fallback="No end"></span>
                        </small>
                      <% } else { %>
                        <small class="text-muted-sm">Always active</small>
                      <% } %>
                    </td>
                    <td data-label="Status">
                      <span class="wp-badge <%= _statusCls %>"><%= _statusLbl %></span>
                    </td>
                    <td data-label="Actions">
                      <div class="row-actions">
                        <a class="row-action-btn edit"
                           href="/dashboard/announcements/edit?announcementId=<%= ann.announcementId %>">
                          <i class="fas fa-pen" aria-hidden="true"></i> Edit
                        </a>
                        <form action="<%= process.env.siteAddress %>/redirect/announcement/delete" method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Delete this announcement?')">
                          <input type="hidden" name="announcementId" value="<%= ann.announcementId %>">
                          <button type="submit" class="row-action-btn danger">
                            <i class="fas fa-trash" aria-hidden="true"></i> Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% } %>
              <% } %>

            </tbody>
          </table>
        </div>
        <!-- /table-responsive -->

      </div>
      <!-- /wp-list-wrap -->

    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->

  <%- include("../../admin/_footer.ejs", { extraScripts: `
    <script>
      // Parse ISO datetime strings for display
      document.querySelectorAll('.js-datetime').forEach(function (el) {
        var iso = el.dataset.iso;
        if (!iso) { el.textContent = el.dataset.fallback || ''; return; }
        var normalized = iso.includes(' ') ? iso.replace(' ', 'T') : iso;
        var withZ = normalized.endsWith('Z') ? normalized : normalized + 'Z';
        var d = new Date(withZ);
        el.textContent = isNaN(d) ? (el.dataset.fallback || '') : d.toLocaleString();
      });
    </script>
  ` }) %>
</div><!-- /#wpcontent -->


<!-- ── Schedule Announcement Modal ─────────────────────────────────────── -->
<div class="modal fade" id="announcementWizardModal" tabindex="-1" aria-labelledby="announcementWizardLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="announcementWizardLabel">Schedule Announcement</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="announcementWizardForm"
              method="post"
              action="<%= process.env.siteAddress %>/redirect/announcement/create">
          <input type="hidden" name="timezoneOffset" value="">

          <!-- Step 1: Content -->
          <div class="wizard-step" data-step="1">
            <div class="mb-3">
              <label for="announcementType" class="form-label fw-semibold">Announcement Type</label>
              <select name="announcementType" id="announcementType" class="form-select" required>
                <option value="" disabled selected>Select a type…</option>
                <option value="motd">Server Ping MOTD</option>
                <option value="tip">In-Game Tip</option>
                <option value="web">Website Banner</option>
                <option value="popup">Website Popup</option>
              </select>
            </div>

            <div class="mb-3" data-announcement-field="body">
              <label for="ann-body" class="form-label fw-semibold">Announcement Text</label>
              <textarea name="body" id="ann-body" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3 d-none" data-announcement-field="colourMessageFormat">
              <label for="ann-colour" class="form-label fw-semibold">Colour Message Format</label>
              <textarea name="colourMessageFormat" id="ann-colour" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3 d-none" data-announcement-field="link">
              <label for="ann-link" class="form-label fw-semibold">Announcement Link</label>
              <input type="url" name="link" id="ann-link" class="form-control">
            </div>

            <div class="mb-3 d-none" data-announcement-field="popupButtonText">
              <label for="ann-btn" class="form-label fw-semibold">Popup Button Text</label>
              <input type="text" name="popupButtonText" id="ann-btn" class="form-control">
              <small class="text-muted">Optional label for the popup call-to-action button.</small>
            </div>

            <div class="mb-3 d-none" data-announcement-field="popupImageUrl">
              <label for="ann-img" class="form-label fw-semibold">Popup Image URL</label>
              <input type="url" name="popupImageUrl" id="ann-img" class="form-control">
              <small class="text-muted">Optional banner image for popup announcements.</small>
            </div>
          </div>

          <!-- Step 2: Scheduling -->
          <div class="wizard-step d-none" data-step="2">
            <div class="mb-3">
              <label for="ann-enabled" class="form-label fw-semibold">Visibility</label>
              <select name="enabled" id="ann-enabled" class="form-select" required>
                <option value="1" selected>Enabled</option>
                <option value="0">Disabled</option>
              </select>
            </div>
            <div class="row">
              <div class="col mb-3">
                <label for="ann-start" class="form-label fw-semibold">Start Date</label>
                <input type="datetime-local" name="startDate" id="ann-start" class="form-control">
              </div>
              <div class="col mb-3">
                <label for="ann-end" class="form-label fw-semibold">End Date</label>
                <input type="datetime-local" name="endDate" id="ann-end" class="form-control">
              </div>
            </div>
            <small class="text-muted">All times are in your local timezone.</small>
          </div>

        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary wizard-back" disabled>Back</button>
        <button type="button" class="btn btn-primary wizard-next">Next</button>
        <button type="submit" form="announcementWizardForm" class="btn btn-success d-none wizard-submit">Schedule</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var modal   = document.getElementById('announcementWizardModal');
  if (!modal) return;
  var steps   = modal.querySelectorAll('.wizard-step');
  var nextBtn = modal.querySelector('.wizard-next');
  var backBtn = modal.querySelector('.wizard-back');
  var subBtn  = modal.querySelector('.wizard-submit');
  var step    = 0;

  function render() {
    steps.forEach(function (s, i) { s.classList.toggle('d-none', i !== step); });
    backBtn.disabled = step === 0;
    nextBtn.classList.toggle('d-none', step === steps.length - 1);
    subBtn.classList.toggle('d-none', step !== steps.length - 1);
  }

  nextBtn.addEventListener('click', function () { if (step < steps.length - 1) { step++; render(); } });
  backBtn.addEventListener('click', function () { if (step > 0) { step--; render(); } });

  modal.addEventListener('hidden.bs.modal', function () {
    step = 0;
    render();
    var f = modal.querySelector('form');
    if (f) f.reset();
    setMinDates();
    syncTimezone();
    updateFields();
  });

  // Field visibility by type
  var typeSelect = modal.querySelector('select[name="announcementType"]');
  var fieldGroups = modal.querySelectorAll('[data-announcement-field]');

  function updateFields() {
    var type = typeSelect ? typeSelect.value : '';
    fieldGroups.forEach(function (g) {
      var field = g.dataset.announcementField;
      var show  = true;
      if (field === 'colourMessageFormat') show = type === 'motd' || type === 'tip';
      if (field === 'link')               show = type === 'web'  || type === 'popup';
      if (field === 'popupButtonText' || field === 'popupImageUrl') show = type === 'popup';
      g.classList.toggle('d-none', !show);
    });
  }

  if (typeSelect) {
    typeSelect.addEventListener('change', updateFields);
    updateFields();
  }

  // Date minimums
  function setMinDates() {
    var now    = new Date();
    var offset = now.getTimezoneOffset();
    var local  = new Date(now.getTime() - offset * 60000).toISOString().slice(0, 16);
    modal.querySelectorAll('input[type="datetime-local"]').forEach(function (inp) { inp.min = local; });
  }

  function syncTimezone() {
    var off = String(new Date().getTimezoneOffset());
    modal.querySelectorAll('input[name="timezoneOffset"]').forEach(function (inp) { inp.value = off; });
  }

  setMinDates();
  syncTimezone();
  render();
}());
</script>
