<%- include("../admin/_head.ejs", { pageTitle }) %>
<%- include("../admin/_topbar.ejs") %>
<%- include("../admin/_sidebar.ejs") %>

<%
  function badge(enabled) {
    return enabled
      ? '<span class="wp-badge active" style="font-size:11px;padding:3px 8px;">Enabled</span>'
      : '<span class="wp-badge inactive" style="font-size:11px;padding:3px 8px;">Disabled</span>';
  }
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="wp-admin-page-header">
        <h1 class="wp-heading-inline">Settings</h1>
      </div>
      <hr class="wp-section-divider">

      <%- include("../admin/_notices.ejs") %>

      <p style="font-size:13px;color:#646970;margin-bottom:20px;">
        Feature flags are configured in <code>features.json</code>. This page shows the current state of each feature.
        See <code>features.json.example</code> for all available options.
      </p>

      <!-- ── Dashboard Features ──────────────────────────────────────────── -->
      <div class="wp-card" style="margin-bottom:20px;">
        <div class="wp-card-header">
          <h2 class="wp-card-title"><i class="fas fa-th-large" aria-hidden="true"></i> Dashboard Features</h2>
        </div>
        <div class="wp-card-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <tbody>
              <% const dashboardFeatures = [
                { label: 'Support Tickets',   desc: 'Ticketing system — manage tickets, categories, and Discord panel',  value: features.support },
                { label: 'Announcements',     desc: 'Site announcements management',                                      value: features.announcements },
                { label: 'Forums',            desc: 'Forum category and thread management',                                value: features.forums },
                { label: 'Servers',           desc: 'Server management',                                                  value: features.server },
                { label: 'Applications',      desc: 'Staff applications management',                                      value: features.applications },
                { label: 'Events',            desc: 'Events calendar and scheduling',                                     value: features.events },
                { label: 'Voting',            desc: 'Vote sites, leaderboard, and reward management',                     value: features.vote },
                { label: 'Vault',             desc: 'Vault and redirect management',                                      value: features.vault },
                { label: 'Ranks',             desc: 'Rank management via LuckPerms',                                      value: features.ranks },
                { label: 'Reports',           desc: 'Player report system',                                               value: features.report },
                { label: 'Shop Directory',    desc: 'Shop directory listing feature',                                     value: features.shopdirectory },
                { label: 'Bridge',            desc: 'Bridge processor monitoring',                                        value: features.bridge },
                { label: 'Staff Audit',       desc: 'Automated staff activity audit reports',                             value: features.staffAuditReport },
                { label: 'Content Watch',     desc: 'YouTube / Twitch content monitoring and announcements',              value: features.watch },
              ]; %>
              <% dashboardFeatures.forEach((f, i) => { %>
                <tr style="border-bottom:<%= i < dashboardFeatures.length - 1 ? '1px solid #f0f0f1' : 'none' %>;">
                  <td style="padding:10px 16px;font-weight:600;width:200px;"><%- f.label %></td>
                  <td style="padding:10px 16px;color:#646970;"><%- f.desc %></td>
                  <td style="padding:10px 16px;text-align:right;white-space:nowrap;"><%- badge(f.value) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Web Features ────────────────────────────────────────────────── -->
      <div class="wp-card" style="margin-bottom:20px;">
        <div class="wp-card-header">
          <h2 class="wp-card-title"><i class="fas fa-globe" aria-hidden="true"></i> Web Features</h2>
        </div>
        <div class="wp-card-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <tbody>
              <tr style="border-bottom:1px solid #f0f0f1;">
                <td style="padding:10px 16px;font-weight:600;width:200px;">Login</td>
                <td style="padding:10px 16px;color:#646970;">Allow users to log in to the website</td>
                <td style="padding:10px 16px;text-align:right;"><%- badge(features.web && features.web.login) %></td>
              </tr>
              <tr>
                <td style="padding:10px 16px;font-weight:600;">Registration</td>
                <td style="padding:10px 16px;color:#646970;">Allow new users to register an account</td>
                <td style="padding:10px 16px;text-align:right;"><%- badge(features.web && features.web.register) %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Discord Features ───────────────────────────────────────────── -->
      <div class="wp-card" style="margin-bottom:20px;">
        <div class="wp-card-header">
          <h2 class="wp-card-title"><i class="fab fa-discord" aria-hidden="true"></i> Discord Features</h2>
        </div>
        <div class="wp-card-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <tbody>
              <% const discordFeatures = [
                { label: 'Punishments',        desc: 'Discord punishment commands and logging',               value: features.discord && features.discord.punishments },
                { label: 'General Kenobi',     desc: '"Hello there" / "General Kenobi" greeting listener',   value: features.discord && features.discord.events && features.discord.events.generalKenobi },
                { label: 'Boost Event',        desc: 'Discord Server Boost event handling',                   value: features.discord && features.discord.events && features.discord.events.guildMemberBoost },
                { label: 'Member Verify',      desc: 'Discord member verification event',                     value: features.discord && features.discord.events && features.discord.events.guildMemberVerify },
                { label: 'Nickname Check',     desc: 'Automated Discord nickname compliance checking',        value: features.discord && features.discord.events && features.discord.events.nicknameCheck },
                { label: 'Unverified Reminder',desc: 'Reminders to members who have not yet verified',       value: features.discord && features.discord.events && features.discord.events.unverifiedReminder },
                { label: 'IP Auto-Detect',     desc: 'Automatic IP detection for Discord members',            value: features.discord && features.discord.events && features.discord.events.ipAutoDetect },
              ]; %>
              <% discordFeatures.forEach((f, i) => { %>
                <tr style="border-bottom:<%= i < discordFeatures.length - 1 ? '1px solid #f0f0f1' : 'none' %>;">
                  <td style="padding:10px 16px;font-weight:600;width:200px;"><%- f.label %></td>
                  <td style="padding:10px 16px;color:#646970;"><%- f.desc %></td>
                  <td style="padding:10px 16px;text-align:right;"><%- badge(f.value) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Content Filters ────────────────────────────────────────────── -->
      <div class="wp-card" style="margin-bottom:20px;">
        <div class="wp-card-header">
          <h2 class="wp-card-title"><i class="fas fa-filter" aria-hidden="true"></i> Content Filters</h2>
        </div>
        <div class="wp-card-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <tbody>
              <tr style="border-bottom:1px solid #f0f0f1;">
                <td style="padding:10px 16px;font-weight:600;width:200px;">Link Filter</td>
                <td style="padding:10px 16px;color:#646970;">Automatically detect and filter disallowed links</td>
                <td style="padding:10px 16px;text-align:right;"><%- badge(features.filter && features.filter.link) %></td>
              </tr>
              <tr>
                <td style="padding:10px 16px;font-weight:600;">Phrase Filter</td>
                <td style="padding:10px 16px;color:#646970;">Automatically detect and filter disallowed phrases</td>
                <td style="padding:10px 16px;text-align:right;"><%- badge(features.filter && features.filter.phrase) %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Social Media ───────────────────────────────────────────────── -->
      <div class="wp-card" style="margin-bottom:30px;">
        <div class="wp-card-header">
          <h2 class="wp-card-title"><i class="fas fa-share-alt" aria-hidden="true"></i> Social Media Links</h2>
        </div>
        <div class="wp-card-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <tbody>
              <% const socialFeatures = [
                { label: 'Discord',   icon: 'fab fa-discord',   value: features.smDiscord },
                { label: 'Facebook',  icon: 'fab fa-facebook',  value: features.smFacebook },
                { label: 'Twitter / X', icon: 'fab fa-twitter', value: features.smTwitter },
                { label: 'Instagram', icon: 'fab fa-instagram', value: features.smInstagram },
                { label: 'Reddit',    icon: 'fab fa-reddit',    value: features.smReddit },
                { label: 'Twitch',    icon: 'fab fa-twitch',    value: features.smTwitch },
                { label: 'YouTube',   icon: 'fab fa-youtube',   value: features.smYouTube },
                { label: 'LinkedIn',  icon: 'fab fa-linkedin',  value: features.smLinkedIn },
                { label: 'TikTok',    icon: 'fab fa-tiktok',    value: features.smTikTok },
              ]; %>
              <% socialFeatures.forEach((f, i) => { %>
                <tr style="border-bottom:<%= i < socialFeatures.length - 1 ? '1px solid #f0f0f1' : 'none' %>;">
                  <td style="padding:10px 16px;font-weight:600;width:200px;">
                    <i class="<%= f.icon %>" style="width:16px;text-align:center;margin-right:6px;"></i><%- f.label %>
                  </td>
                  <td style="padding:10px 16px;color:#646970;">Show <%= f.label %> link on the site</td>
                  <td style="padding:10px 16px;text-align:right;"><%- badge(f.value) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->

  <%- include("../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->
