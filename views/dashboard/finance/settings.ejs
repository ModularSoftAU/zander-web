<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-gear fa-fw me-2"></i>Finance Settings</h1>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <%# Categories -%>
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold"><i class="fa-solid fa-tags me-1"></i>Categories</span>
          <% if (canManage) { %>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
              <i class="fa-solid fa-plus me-1"></i>Add
            </button>
          <% } %>
        </div>
        <div class="card-body p-0">
          <% if (!categories || !categories.length) { %>
            <div class="p-3 text-muted small">No categories configured.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Name</th><th>Type</th><th>Parent</th><% if (canManage) { %><th></th><% } %></tr></thead>
                <tbody>
                  <% categories.forEach(function(cat) { %>
                    <tr>
                      <td class="fw-semibold"><%= cat.name %></td>
                      <td><span class="badge <%= cat.type === 'income' ? 'bg-success' : cat.type === 'expense' ? 'bg-danger' : 'bg-info text-dark' %>"><%= cat.type || '—' %></span></td>
                      <td class="text-muted small"><%= cat.parent ? cat.parent.name : '—' %></td>
                      <% if (canManage) { %>
                        <td class="text-end">
                          <form method="post" action="/dashboard/finance/settings/categories/<%= cat.categoryId %>/delete" class="d-inline"
                                onsubmit="return confirm('Delete category <%= (cat.name||'').replace(/'/g,'&#39;') %>?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                          </form>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<% if (canManage) { %>

<%# Add Category Modal -%>
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/dashboard/finance/settings/categories/create">
        <div class="modal-header">
          <h5 class="modal-title" id="addCategoryModalLabel">Add Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="catName" class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="catName" name="name" required maxlength="150" placeholder="e.g. Hosting, Marketing">
          </div>
          <div class="mb-3">
            <label for="catType" class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
            <select class="form-select" id="catType" name="type" required>
              <option value="">— Select —</option>
              <option value="expense">Expense</option>
              <option value="income">Income</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="catParentId" class="form-label fw-semibold">Parent Category</label>
            <select class="form-select" id="catParentId" name="parentId">
              <option value="">— None (top-level) —</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.categoryId %>"><%= cat.name %> (<%= cat.type %>)</option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% } %>
