<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-pen fa-fw me-2"></i>Edit Vendor</h1>
        <a href="/dashboard/finance/vendors/<%= vendor.vendorId %>" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Vendor
        </a>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="row justify-content-center">
        <div class="col-lg-7">
          <div class="card shadow-sm">
            <div class="card-body">
              <form method="post" action="/dashboard/finance/vendors/<%= vendor.vendorId %>/edit">
                <div class="mb-3">
                  <label for="name" class="form-label fw-semibold">Vendor Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="name" name="name" required maxlength="150" value="<%= vendor.name %>">
                </div>
                <div class="mb-3">
                  <label for="website" class="form-label fw-semibold">Website URL</label>
                  <input type="url" class="form-control" id="website" name="website" maxlength="255" value="<%= vendor.website || '' %>">
                </div>
                <div class="mb-3">
                  <label for="contactEmail" class="form-label fw-semibold">Contact Email</label>
                  <input type="email" class="form-control" id="contactEmail" name="contactEmail" maxlength="180" value="<%= vendor.contactEmail || '' %>">
                </div>
                <div class="mb-3">
                  <label for="categoryId" class="form-label fw-semibold">Category</label>
                  <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">— None —</option>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat.categoryId %>" <%= String(vendor.categoryId) === String(cat.categoryId) ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="1" <%= vendor.isActive ? 'checked' : '' %>>
                    <label class="form-check-label" for="isActive">Active</label>
                  </div>
                </div>
                <div class="mb-3">
                  <label for="notes" class="form-label fw-semibold">Notes</label>
                  <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="2000"><%= vendor.notes || '' %></textarea>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                  <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Save Changes</button>
                  <a href="/dashboard/finance/vendors/<%= vendor.vendorId %>" class="btn btn-outline-secondary">Cancel</a>
                  <form method="post" action="/dashboard/finance/vendors/<%= vendor.vendorId %>/delete" class="ms-auto"
                    onsubmit="return confirm('Delete <%= vendor.name.replace(/'/g,'&#39;') %>? This cannot be undone.')">
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Delete Vendor</button>
                  </form>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
