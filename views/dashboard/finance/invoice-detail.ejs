<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <% const statusColors = { pending:'bg-warning text-dark', partial:'bg-info text-dark', paid:'bg-success', overdue:'bg-danger', cancelled:'bg-secondary' }; %>

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div>
          <h1 class="h2 mb-0"><i class="fa-solid fa-file-invoice fa-fw me-2"></i><%= invoice.invoiceNumber %></h1>
          <div class="text-muted small mt-1">
            <a href="/dashboard/finance/vendors/<%= invoice.vendorId %>" class="text-decoration-none text-muted"><%= invoice.vendorName %></a>
            <span class="ms-2"><span class="badge <%= statusColors[invoice.status] || 'bg-secondary' %>"><%= invoice.status %></span></span>
          </div>
        </div>
        <div class="btn-toolbar gap-2">
          <% if (canManage && invoice.status !== 'paid' && invoice.status !== 'cancelled') { %>
            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
              <i class="fa-solid fa-dollar-sign me-1"></i>Record Payment
            </button>
          <% } %>
          <% if (canManage) { %>
            <a href="/dashboard/finance/invoices/<%= invoice.invoiceId %>/edit" class="btn btn-sm btn-warning">
              <i class="fa-solid fa-pen me-1"></i>Edit
            </a>
          <% } %>
          <a href="/dashboard/finance/invoices" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Invoices
          </a>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <%# Summary cards -%>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold">
                <%= new Intl.NumberFormat('en-US',{style:'currency',currency:invoice.currency||'USD'}).format((invoice.amountCents||0)/100) %>
              </div>
              <div class="text-muted small">Invoice Amount</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold text-success">
                <%= new Intl.NumberFormat('en-US',{style:'currency',currency:invoice.currency||'USD'}).format((invoice.paidAmountCents||0)/100) %>
              </div>
              <div class="text-muted small">Paid</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <% const remaining = (invoice.amountCents||0) - (invoice.paidAmountCents||0); %>
              <div class="fs-5 fw-bold <%= remaining > 0 ? 'text-danger' : '' %>">
                <%= new Intl.NumberFormat('en-US',{style:'currency',currency:invoice.currency||'USD'}).format(Math.max(0,remaining)/100) %>
              </div>
              <div class="text-muted small">Remaining</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold <%= invoice.status === 'overdue' ? 'text-danger' : '' %>">
                <%= invoice.dueDate ? new Date(invoice.dueDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %>
              </div>
              <div class="text-muted small">Due Date</div>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <%# Invoice details -%>
        <div class="col-md-4">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Invoice Details</div>
            <div class="card-body">
              <dl class="mb-0">
                <dt class="text-muted small">Vendor</dt>
                <dd>
                  <div class="d-flex align-items-center gap-2">
                    <% if (invoice.faviconUrl) { %>
                      <img src="<%= invoice.faviconUrl %>" width="18" height="18" alt="" class="rounded" onerror="this.style.display='none'">
                    <% } %>
                    <a href="/dashboard/finance/vendors/<%= invoice.vendorId %>" class="text-decoration-none"><%= invoice.vendorName %></a>
                  </div>
                </dd>
                <dt class="text-muted small mt-2">Issue Date</dt>
                <dd><%= invoice.issueDate ? new Date(invoice.issueDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></dd>
                <% if (invoice.categoryName) { %>
                  <dt class="text-muted small mt-2">Category</dt>
                  <dd><span class="badge bg-secondary"><%= invoice.categoryName %></span></dd>
                <% } %>
                <% if (invoice.description) { %>
                  <dt class="text-muted small mt-2">Description</dt>
                  <dd class="text-muted small"><%= invoice.description %></dd>
                <% } %>
              </dl>
            </div>
          </div>
        </div>

        <%# Payments -%>
        <div class="col-md-8">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Payments</div>
            <div class="card-body p-0">
              <% if (!payments || !payments.length) { %>
                <div class="p-3 text-muted small">No payments recorded yet.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Date</th><th>Account</th><th class="text-end">Amount</th><th>Notes</th><% if (canManage) { %><th></th><% } %></tr></thead>
                    <tbody>
                      <% payments.forEach(function(p) {
                        const amtStr = new Intl.NumberFormat('en-US',{style:'currency',currency:p.currency||'USD'}).format((p.amountCents||0)/100);
                      %>
                        <tr>
                          <td class="text-muted small"><%= p.paidDate ? new Date(p.paidDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                          <td class="text-muted small"><%= p.accountName || '—' %></td>
                          <td class="text-end fw-semibold text-success">+<%= amtStr %></td>
                          <td class="text-muted small"><%= p.notes || '' %></td>
                          <% if (canManage) { %>
                            <td class="text-end">
                              <form method="post" action="/dashboard/finance/payments/<%= p.paymentId %>/delete" class="d-inline"
                                    onsubmit="return confirm('Delete this payment?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                              </form>
                            </td>
                          <% } %>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%# Attachments -%>
      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold"><i class="fa-solid fa-paperclip me-1"></i>Attachments</span>
          <% if (canManage) { %>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#uploadModal">
              <i class="fa-solid fa-upload me-1"></i>Upload
            </button>
          <% } %>
        </div>
        <div class="card-body">
          <% if (!attachments || !attachments.length) { %>
            <p class="text-muted small mb-0">No attachments.</p>
          <% } else { %>
            <div class="row g-2">
              <% attachments.forEach(function(att) { %>
                <div class="col-12 col-md-6 col-xl-4">
                  <div class="border rounded p-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                      <i class="fa-solid fa-file-pdf text-danger fa-fw"></i>
                      <div class="min-w-0">
                        <div class="fw-semibold small text-truncate"><%= att.label || att.fileName %></div>
                        <div class="text-muted" style="font-size:0.72rem;"><%= att.fileName %> &middot; <%= Math.round((att.fileSizeBytes||0)/1024) %>KB</div>
                      </div>
                    </div>
                    <div class="d-flex gap-1 ms-2">
                      <a href="<%= att.fileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-download"></i>
                      </a>
                      <% if (canManage) { %>
                        <form method="post" action="/dashboard/finance/attachments/<%= att.attachmentId %>/delete" class="d-inline"
                              onsubmit="return confirm('Delete this attachment?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<%# Add Payment Modal -%>
<% if (canManage && invoice.status !== 'paid' && invoice.status !== 'cancelled') { %>
<div class="modal fade" id="addPaymentModal" tabindex="-1" aria-labelledby="addPaymentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/dashboard/finance/invoices/<%= invoice.invoiceId %>/payments">
        <div class="modal-header">
          <h5 class="modal-title" id="addPaymentModalLabel">Record Payment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="paidDate" class="form-label fw-semibold">Payment Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="paidDate" name="paidDate" required>
          </div>
          <div class="mb-3">
            <label for="payAmount" class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="number" class="form-control" id="payAmount" name="amountCents" required min="0.01" step="0.01"
                     value="<%= Math.max(0,((invoice.amountCents||0)-(invoice.paidAmountCents||0))/100).toFixed(2) %>">
            </div>
          </div>
          <div class="mb-3">
            <label for="payAccountId" class="form-label fw-semibold">Account</label>
            <select class="form-select" id="payAccountId" name="accountId">
              <option value="">— None —</option>
              <% accounts.forEach(function(acc) { %>
                <option value="<%= acc.accountId %>"><%= acc.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="payNotes" class="form-label fw-semibold">Notes</label>
            <input type="text" class="form-control" id="payNotes" name="notes" maxlength="500" placeholder="Reference number, payment method...">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success"><i class="fa-solid fa-check me-1"></i>Record Payment</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%# Upload Attachment Modal -%>
<% if (canManage) { %>
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/dashboard/finance/invoices/<%= invoice.invoiceId %>/attachments" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title" id="uploadModalLabel">Upload Attachment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="attFile" class="form-label fw-semibold">File (PDF) <span class="text-danger">*</span></label>
            <input type="file" class="form-control" id="attFile" name="file" required accept=".pdf,application/pdf">
          </div>
          <div class="mb-3">
            <label for="attLabel" class="form-label fw-semibold">Label</label>
            <input type="text" class="form-control" id="attLabel" name="label" maxlength="200" placeholder="e.g. Original Invoice, Receipt">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-upload me-1"></i>Upload</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
