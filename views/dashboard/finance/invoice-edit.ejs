<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-file-invoice fa-fw me-2"></i>Edit Invoice</h1>
        <a href="/dashboard/finance/invoices/<%= invoice.invoiceId %>" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Invoice
        </a>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <form method="post" action="/dashboard/finance/invoices/<%= invoice.invoiceId %>/edit">

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label for="vendorId" class="form-label fw-semibold">Vendor <span class="text-danger">*</span></label>
                    <select class="form-select" id="vendorId" name="vendorId" required>
                      <option value="">— Select Vendor —</option>
                      <% vendors.forEach(function(v) { %>
                        <option value="<%= v.vendorId %>" <%= String(v.vendorId) === String(invoice.vendorId) ? 'selected' : '' %>><%= v.name %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="invoiceNumber" class="form-label fw-semibold">Invoice Number <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="invoiceNumber" name="invoiceNumber" required maxlength="100"
                           value="<%= invoice.invoiceNumber || '' %>">
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-4">
                    <label for="issueDate" class="form-label fw-semibold">Issue Date</label>
                    <input type="date" class="form-control" id="issueDate" name="issueDate"
                           value="<%= invoice.issueDate ? new Date(invoice.issueDate).toISOString().slice(0,10) : '' %>">
                  </div>
                  <div class="col-md-4">
                    <label for="dueDate" class="form-label fw-semibold">Due Date</label>
                    <input type="date" class="form-control" id="dueDate" name="dueDate"
                           value="<%= invoice.dueDate ? new Date(invoice.dueDate).toISOString().slice(0,10) : '' %>">
                  </div>
                  <div class="col-md-4">
                    <label for="currency" class="form-label fw-semibold">Currency</label>
                    <select class="form-select" id="currency" name="currency">
                      <% ['USD','AUD','EUR','GBP','CAD'].forEach(function(c) { %>
                        <option value="<%= c %>" <%= c === (invoice.currency || 'USD') ? 'selected' : '' %>><%= c %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label for="amountCents" class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input type="number" class="form-control" id="amountCents" name="amountCents" required min="0.01" step="0.01"
                             value="<%= ((invoice.amountCents || 0) / 100).toFixed(2) %>">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label for="status" class="form-label fw-semibold">Status</label>
                    <select class="form-select" id="status" name="status">
                      <% ['pending','partial','paid','overdue','cancelled'].forEach(function(s) { %>
                        <option value="<%= s %>" <%= s === invoice.status ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="categoryId" class="form-label fw-semibold">Category</label>
                  <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">— None —</option>
                    <% categories.filter(c => c.type === 'expense').forEach(function(cat) { %>
                      <option value="<%= cat.categoryId %>" <%= String(cat.categoryId) === String(invoice.categoryId) ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="description" class="form-label fw-semibold">Description</label>
                  <textarea class="form-control" id="description" name="description" rows="3" maxlength="2000"><%= invoice.description || '' %></textarea>
                </div>

                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-warning"><i class="fa-solid fa-check me-1"></i>Save Changes</button>
                  <a href="/dashboard/finance/invoices/<%= invoice.invoiceId %>" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
