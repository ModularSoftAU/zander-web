<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-money-check-dollar fa-fw me-2"></i>Payments</h1>
        <div class="btn-toolbar gap-2">
          <% if (canManage) { %>
            <a href="/dashboard/finance/payments/create" class="btn btn-sm btn-primary">
              <i class="fa-solid fa-plus me-1"></i>Record Payment
            </a>
          <% } %>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <p class="text-muted small mb-3"><%= totalCount %> payment<%= totalCount !== 1 ? 's' : '' %> found.</p>

      <% if (!payments || !payments.length) { %>
        <div class="alert alert-info">No payments found.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Date</th>
                <th>Invoice</th>
                <th>Vendor</th>
                <th>Account</th>
                <th class="text-end">Amount</th>
                <th>Notes</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(function(p) {
                const amtStr = new Intl.NumberFormat('en-US',{style:'currency',currency:p.currency||'USD'}).format((p.amountCents||0)/100);
              %>
                <tr>
                  <td class="text-muted small"><%= p.paidDate ? new Date(p.paidDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                  <td>
                    <% if (p.invoiceNumber) { %>
                      <a href="/dashboard/finance/invoices/<%= p.invoiceId %>" class="text-decoration-none fw-semibold"><%= p.invoiceNumber %></a>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.vendorName) { %>
                      <a href="/dashboard/finance/vendors/<%= p.vendorId %>" class="text-decoration-none text-muted small"><%= p.vendorName %></a>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td class="text-muted small"><%= p.accountName || '—' %></td>
                  <td class="text-end fw-semibold text-danger">−<%= amtStr %></td>
                  <td class="text-muted small"><%= p.notes || '' %></td>
                  <td class="text-end">
                    <% if (canManage) { %>
                      <form method="post" action="/dashboard/finance/payments/<%= p.paymentId %>/delete" class="d-inline"
                            onsubmit="return confirm('Delete this payment? This cannot be undone.')">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <%# Pagination -%>
        <% if (totalPages > 1) { %>
          <nav aria-label="Payment pagination">
            <ul class="pagination justify-content-center">
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %>"><i class="fa-solid fa-chevron-left"></i></a>
              </li>
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %>"><i class="fa-solid fa-chevron-right"></i></a>
              </li>
            </ul>
          </nav>
        <% } %>
      <% } %>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
