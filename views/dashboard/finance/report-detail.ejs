<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <% const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December']; %>
      <% const periodLabel = monthNames[(report.month||1)-1] + ' ' + report.year; %>

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div>
          <h1 class="h2 mb-0"><i class="fa-solid fa-file-chart-column fa-fw me-2"></i><%= periodLabel %> Report</h1>
          <div class="text-muted small mt-1">
            <% if (report.isPublished) { %>
              <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Published</span>
            <% } else { %>
              <span class="badge bg-secondary">Draft</span>
            <% } %>
            <% if (report.isLocked) { %>
              <span class="badge bg-warning text-dark ms-1"><i class="fa-solid fa-lock fa-xs me-1"></i>Locked</span>
            <% } %>
            <span class="ms-2">Generated <%= report.generatedAt ? new Date(report.generatedAt).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></span>
          </div>
        </div>
        <div class="btn-toolbar gap-2">
          <% if (canManage) { %>
            <form method="post" action="/dashboard/finance/reports/generate">
              <input type="hidden" name="year" value="<%= report.year %>">
              <input type="hidden" name="month" value="<%= report.month %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-rotate me-1"></i>Regenerate
              </button>
            </form>
            <% if (!report.isPublished) { %>
              <form method="post" action="/dashboard/finance/reports/<%= report.reportId %>/publish"
                    onsubmit="return confirm('Publish this report? This will lock all transactions for <%= periodLabel %> and cannot be undone.')">
                <button type="submit" class="btn btn-sm btn-success">
                  <i class="fa-solid fa-paper-plane me-1"></i>Publish & Lock
                </button>
              </form>
            <% } %>
          <% } %>
          <a href="/dashboard/finance/reports" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Reports
          </a>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <%# Summary cards -%>
      <% const net = (report.totalIncomeCents||0) - (report.totalExpenseCents||0); %>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold text-success">
                +<%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((report.totalIncomeCents||0)/100) %>
              </div>
              <div class="text-muted small">Total Income</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold text-danger">
                −<%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((report.totalExpenseCents||0)/100) %>
              </div>
              <div class="text-muted small">Total Expenses</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold <%= net >= 0 ? 'text-success' : 'text-danger' %>">
                <%= net >= 0 ? '+' : '−' %><%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Math.abs(net)/100) %>
              </div>
              <div class="text-muted small">Net</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold"><%= report.transactionCount || 0 %></div>
              <div class="text-muted small">Transactions</div>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <%# By category -%>
        <div class="col-md-6">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Expenses by Category</div>
            <div class="card-body p-0">
              <% if (!categoryBreakdown || !categoryBreakdown.length) { %>
                <div class="p-3 text-muted small">No data.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Category</th><th class="text-end">Amount</th><th class="text-end">Txns</th></tr></thead>
                    <tbody>
                      <% categoryBreakdown.forEach(function(row) { %>
                        <tr>
                          <td><span class="badge bg-secondary"><%= row.categoryName || 'Uncategorised' %></span></td>
                          <td class="text-end text-danger">−<%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((row.totalCents||0)/100) %></td>
                          <td class="text-end text-muted small"><%= row.count %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <%# By vendor -%>
        <div class="col-md-6">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Top Vendors</div>
            <div class="card-body p-0">
              <% if (!vendorBreakdown || !vendorBreakdown.length) { %>
                <div class="p-3 text-muted small">No data.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Vendor</th><th class="text-end">Amount</th><th class="text-end">Invoices</th></tr></thead>
                    <tbody>
                      <% vendorBreakdown.forEach(function(row) { %>
                        <tr>
                          <td>
                            <div class="d-flex align-items-center gap-2">
                              <% if (row.faviconUrl) { %>
                                <img src="<%= row.faviconUrl %>" width="16" height="16" alt="" class="rounded" onerror="this.style.display='none'">
                              <% } %>
                              <a href="/dashboard/finance/vendors/<%= row.vendorId %>" class="text-decoration-none text-muted"><%= row.vendorName %></a>
                            </div>
                          </td>
                          <td class="text-end text-danger">−<%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((row.totalCents||0)/100) %></td>
                          <td class="text-end text-muted small"><%= row.count %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%# Transactions in period -%>
      <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">All Transactions</div>
        <div class="card-body p-0">
          <% if (!transactions || !transactions.length) { %>
            <div class="p-3 text-muted small">No transactions in this period.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Date</th><th>Description</th><th>Type</th><th>Category</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                  <% transactions.forEach(function(tx) {
                    const typeColors = { income:'bg-success', expense:'bg-danger', transfer:'bg-info text-dark' };
                    const amtStr = new Intl.NumberFormat('en-US',{style:'currency',currency:tx.currency||'USD'}).format((tx.amountCents||0)/100);
                  %>
                    <tr>
                      <td class="text-muted small"><%= tx.txDate ? new Date(tx.txDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                      <td><a href="/dashboard/finance/transactions/<%= tx.transactionId %>" class="text-decoration-none"><%= tx.description %></a></td>
                      <td><span class="badge <%= typeColors[tx.type] || 'bg-secondary' %>"><%= tx.type %></span></td>
                      <td><% if (tx.categoryName) { %><span class="badge bg-secondary"><%= tx.categoryName %></span><% } else { %><span class="text-muted">—</span><% } %></td>
                      <td class="text-end fw-semibold <%= tx.type === 'income' ? 'text-success' : tx.type === 'expense' ? 'text-danger' : '' %>">
                        <%= tx.type === 'income' ? '+' : tx.type === 'expense' ? '−' : '' %><%= amtStr %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
