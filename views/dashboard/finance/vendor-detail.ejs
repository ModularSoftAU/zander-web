<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
          <% if (vendor.faviconUrl) { %>
            <img src="<%= vendor.faviconUrl %>" width="36" height="36" alt="" class="rounded" onerror="this.style.display='none'">
          <% } else { %>
            <span class="rounded d-flex align-items-center justify-content-center bg-light border" style="width:36px;height:36px;font-size:18px;"><i class="fa-solid fa-building text-muted"></i></span>
          <% } %>
          <div>
            <h1 class="h2 mb-0"><%= vendor.name %></h1>
            <% if (vendor.website) { %>
              <a href="<%= vendor.website %>" target="_blank" rel="noopener noreferrer" class="text-muted small">
                <%= vendor.website.replace(/^https?:\/\/(www\.)?/,'').split('/')[0] %>
                <i class="fa-solid fa-arrow-up-right-from-square fa-xs ms-1"></i>
              </a>
            <% } %>
          </div>
        </div>
        <div class="btn-toolbar gap-2">
          <% if (canManage) { %>
            <form method="post" action="/dashboard/finance/vendors/<%= vendor.vendorId %>/refresh-favicon" class="d-inline">
              <button type="submit" class="btn btn-sm btn-outline-secondary" title="Refresh favicon">
                <i class="fa-solid fa-rotate me-1"></i>Refresh Favicon
              </button>
            </form>
            <a href="/dashboard/finance/vendors/<%= vendor.vendorId %>/edit" class="btn btn-sm btn-warning">
              <i class="fa-solid fa-pen me-1"></i>Edit
            </a>
          <% } %>
          <a href="/dashboard/finance/vendors" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Vendors
          </a>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <%# Stats row -%>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold text-danger">
                <%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((stats.totalSpentCents||0)/100) %>
              </div>
              <div class="text-muted small">Total Spent</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold <%= (stats.unpaidAmountCents||0) > 0 ? 'text-warning' : '' %>">
                <%= new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format((stats.unpaidAmountCents||0)/100) %>
              </div>
              <div class="text-muted small">Unpaid</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold"><%= stats.unpaidInvoicesCount || 0 %></div>
              <div class="text-muted small">Open Invoices</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card shadow-sm text-center">
            <div class="card-body py-2">
              <div class="fs-5 fw-bold <%= (stats.overdueInvoicesCount||0) > 0 ? 'text-danger' : '' %>">
                <%= stats.overdueInvoicesCount || 0 %>
              </div>
              <div class="text-muted small">Overdue</div>
            </div>
          </div>
        </div>
      </div>

      <%# Info + Invoices row -%>
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Vendor Details</div>
            <div class="card-body">
              <dl class="mb-0">
                <dt class="text-muted small">Status</dt>
                <dd><span class="badge <%= vendor.isActive ? 'bg-success' : 'bg-secondary' %>"><%= vendor.isActive ? 'Active' : 'Inactive' %></span></dd>
                <% if (vendor.categoryName) { %>
                  <dt class="text-muted small mt-2">Category</dt>
                  <dd><span class="badge bg-secondary"><%= vendor.categoryName %></span></dd>
                <% } %>
                <% if (vendor.contactEmail) { %>
                  <dt class="text-muted small mt-2">Contact Email</dt>
                  <dd><a href="mailto:<%= vendor.contactEmail %>" class="text-decoration-none"><%= vendor.contactEmail %></a></dd>
                <% } %>
                <% if (vendor.notes) { %>
                  <dt class="text-muted small mt-2">Notes</dt>
                  <dd class="text-muted small"><%= vendor.notes %></dd>
                <% } %>
              </dl>
              <% if (canManage) { %>
                <div class="mt-3 pt-2 border-top">
                  <a href="/dashboard/finance/invoices/create?vendorId=<%= vendor.vendorId %>" class="btn btn-sm btn-primary w-100">
                    <i class="fa-solid fa-file-plus me-1"></i>Add Invoice
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-md-8">
          <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Invoices</span>
              <a href="/dashboard/finance/invoices?vendorId=<%= vendor.vendorId %>" class="btn btn-sm btn-outline-secondary">All Invoices</a>
            </div>
            <div class="card-body p-0">
              <% if (!invoices || !invoices.length) { %>
                <div class="p-3 text-muted small">No invoices for this vendor.</div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>#</th><th>Issue Date</th><th>Due Date</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
                    <tbody>
                      <% invoices.slice(0,8).forEach(function(inv) {
                        const statusColors = { pending:'bg-warning text-dark', partial:'bg-info text-dark', paid:'bg-success', overdue:'bg-danger', cancelled:'bg-secondary' };
                        const amtStr = new Intl.NumberFormat('en-US',{style:'currency',currency:inv.currency||'USD'}).format((inv.amountCents||0)/100);
                      %>
                        <tr>
                          <td><a href="/dashboard/finance/invoices/<%= inv.invoiceId %>" class="text-decoration-none fw-semibold"><%= inv.invoiceNumber %></a></td>
                          <td class="text-muted small"><%= inv.issueDate ? new Date(inv.issueDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                          <td class="text-muted small"><%= inv.dueDate ? new Date(inv.dueDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                          <td class="text-end fw-semibold"><%= amtStr %></td>
                          <td><span class="badge <%= statusColors[inv.status] || 'bg-secondary' %>"><%= inv.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%# Recent Payments -%>
      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Recent Payments</span>
          <a href="/dashboard/finance/payments?vendorId=<%= vendor.vendorId %>" class="btn btn-sm btn-outline-secondary">All Payments</a>
        </div>
        <div class="card-body p-0">
          <% if (!payments || !payments.length) { %>
            <div class="p-3 text-muted small">No payments recorded for this vendor.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Date</th><th>Invoice</th><th>Account</th><th class="text-end">Amount</th><th>Notes</th></tr></thead>
                <tbody>
                  <% payments.slice(0,10).forEach(function(p) {
                    const amtStr = new Intl.NumberFormat('en-US',{style:'currency',currency:p.currency||'USD'}).format((p.amountCents||0)/100);
                  %>
                    <tr>
                      <td class="text-muted small"><%= p.paidDate ? new Date(p.paidDate).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—' %></td>
                      <td><% if (p.invoiceNumber) { %><a href="/dashboard/finance/invoices/<%= p.invoiceId %>" class="text-decoration-none"><%= p.invoiceNumber %></a><% } else { %><span class="text-muted">—</span><% } %></td>
                      <td class="text-muted small"><%= p.accountName || '—' %></td>
                      <td class="text-end fw-semibold text-danger">−<%= amtStr %></td>
                      <td class="text-muted small"><%= p.notes || '' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <%# Attachments -%>
      <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold"><i class="fa-solid fa-paperclip me-1"></i>Documents</div>
        <div class="card-body">
          <% if (!attachments || !attachments.length) { %>
            <p class="text-muted small mb-0">No documents attached to this vendor.</p>
          <% } else { %>
            <div class="row g-2">
              <% attachments.forEach(function(att) { %>
                <div class="col-12 col-md-6 col-xl-4">
                  <div class="border rounded p-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                      <i class="fa-solid fa-file-pdf text-danger fa-fw"></i>
                      <div class="min-w-0">
                        <div class="fw-semibold small text-truncate"><%= att.label || att.fileName %></div>
                        <div class="text-muted" style="font-size:0.72rem;"><%= att.fileName %> &middot; <%= Math.round((att.fileSizeBytes||0)/1024) %>KB</div>
                      </div>
                    </div>
                    <a href="<%= att.fileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary ms-2">
                      <i class="fa-solid fa-download"></i>
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>
