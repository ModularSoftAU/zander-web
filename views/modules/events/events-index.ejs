<%- include("../header.ejs", {
    pageTitle: pageTitle,
    pageDescription: pageDescription
}) %>

<%- include("../navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: "Events",
  backgroundImage: globalImage
}) %>

<style>
.event-card {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
}
.event-banner-img {
    height: 180px;
    object-fit: cover;
    border-radius: .375rem .375rem 0 0;
}
.event-banner-placeholder {
    height: 180px;
    background: linear-gradient(135deg, var(--bs-primary) 0%, #1a3a6e 100%);
    border-radius: .375rem .375rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
.btn-xs { padding: 0.15rem 0.4rem; font-size: 0.75rem; }
</style>

<div class="container py-5">

    <!-- Upcoming Events -->
    <div class="mb-5">
        <div class="mb-4">
            <h2 class="h4 fw-bold mb-1"><i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Events</h2>
            <p class="text-muted mb-0">Events happening soon — don't miss out.</p>
        </div>

        <% if (upcomingEvents && upcomingEvents.length > 0) { %>
        <div class="row g-4">
            <% upcomingEvents.forEach(ev => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 event-card">
                    <% if (ev.bannerUrl) { %>
                        <img src="<%= ev.bannerUrl %>" class="event-banner-img" alt="<%= ev.title %>">
                    <% } else { %>
                        <div class="event-banner-placeholder">
                            <i class="fas fa-calendar-day fa-2x text-white opacity-50"></i>
                        </div>
                    <% } %>
                    <div class="card-body d-flex flex-column">
                        <% if (ev.featured) { %>
                            <span class="badge bg-warning text-dark mb-2" style="width:fit-content"><i class="fas fa-star me-1"></i>Featured</span>
                        <% } %>
                        <h5 class="card-title mb-2">
                            <a href="/events/<%= ev.slug %>" class="text-decoration-none text-body stretched-link"><%= ev.title %></a>
                        </h5>
                        <div class="text-muted small mb-1">
                            <i class="fas fa-clock me-1"></i>
                            <span class="js-datetime" data-iso="<%= ev.startAt ? new Date(ev.startAt).toISOString() : '' %>" data-fallback="TBA"></span>
                        </div>
                        <% if (ev.locationLabel) { %>
                            <div class="text-muted small mb-1"><i class="fas fa-map-marker-alt me-1"></i><%= ev.locationLabel %></div>
                        <% } %>
                        <% if (ev.serverName) { %>
                            <div class="text-muted small mb-1"><i class="fas fa-server me-1"></i><%= ev.serverName %></div>
                        <% } %>
                        <% if (ev.hosts && ev.hosts.length > 0) { %>
                            <div class="text-muted small mt-1">
                                <i class="fas fa-user me-1"></i><%= ev.hosts.map(h => h.displayName || 'Unknown').join(', ') %>
                            </div>
                        <% } %>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pb-3 text-muted small">
                        Ends <span class="js-datetime" data-iso="<%= ev.endAt ? new Date(ev.endAt).toISOString() : '' %>" data-fallback="—"></span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="fas fa-calendar-times fa-2x mb-3 opacity-50"></i>
                <p class="mb-0">No upcoming events scheduled. Check back soon!</p>
            </div>
        </div>
        <% } %>
    </div>

    <!-- All Events -->
    <% if (allEvents.events && allEvents.events.length > 0) { %>
    <div>
        <div class="mb-4">
            <h2 class="h4 fw-bold mb-1"><i class="fas fa-history me-2 text-secondary"></i>All Events</h2>
            <p class="text-muted mb-0">Browse our complete events history.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Event</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% allEvents.events.forEach(ev => { %>
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <% if (ev.logoUrl) { %>
                                        <img src="<%= ev.logoUrl %>" alt="" style="width:32px;height:32px;object-fit:contain;border-radius:4px;flex-shrink:0;">
                                    <% } %>
                                    <div>
                                        <strong><a href="/events/<%= ev.slug %>" class="text-decoration-none"><%= ev.title %></a></strong>
                                        <% if (ev.locationLabel) { %><br><small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i><%= ev.locationLabel %></small><% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="text-muted small"><span class="js-datetime" data-iso="<%= ev.startAt ? new Date(ev.startAt).toISOString() : '' %>"></span></td>
                            <td class="pe-4 text-end"><a href="/events/<%= ev.slug %>" class="btn btn-xs btn-outline-primary">View</a></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (allEvents.total > 12) { %>
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="/events?page=<%= currentPage - 1 %>">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page <%= currentPage %> of <%= Math.ceil(allEvents.total / 12) %></span>
                </li>
                <li class="page-item <%= currentPage >= Math.ceil(allEvents.total / 12) ? 'disabled' : '' %>">
                    <a class="page-link" href="/events?page=<%= currentPage + 1 %>">Next</a>
                </li>
            </ul>
        </nav>
        <% } %>
    </div>
    <% } %>

</div>

<%- include("../footer.ejs") %>

<script>
document.querySelectorAll('.js-datetime').forEach(el => {
    const d = el.dataset.iso ? new Date(el.dataset.iso) : null;
    el.textContent = d && !isNaN(d) ? d.toLocaleString(undefined, {
        weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
        hour: '2-digit', minute: '2-digit', timeZoneName: 'short'
    }) : (el.dataset.fallback || '—');
});
</script>
