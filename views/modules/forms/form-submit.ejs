<%- include("../../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: form.name
}) %>

<%- include("../../modules/navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: form.name,
  backgroundImage: globalImage
}) %>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <% if (req.cookies.alertType) { %>
                    <%- include("../../partials/alert.ejs", {
                        alertType: req.cookies.alertType,
                        content: req.cookies.alertContent
                    }) %>
                <% } %>

                <form method="post" action="/forms/<%= form.slug %>/submit" id="formSubmission">
                    <% let inSection = false; %>

                    <% blocks.forEach(function(block, index) { %>
                        <% if (block.type === 'section_break') { %>
                            <% if (inSection) { %>
                                </div></div>
                            <% } %>
                            <div class="card mb-4">
                                <% if ((block.config && block.config.sectionTitle) || (block.config && block.config.sectionDescription)) { %>
                                    <div class="card-header">
                                        <% if (block.config && block.config.sectionTitle) { %>
                                            <h5 class="mb-0"><%= block.config.sectionTitle %></h5>
                                        <% } %>
                                        <% if (block.config && block.config.sectionDescription) { %>
                                            <small class="text-muted"><%= block.config.sectionDescription %></small>
                                        <% } %>
                                    </div>
                                <% } %>
                                <div class="card-body">
                            <% inSection = true; %>

                        <% } else if (block.type === 'title_description') { %>
                            <div class="mb-4">
                                <% if (block.label) { %>
                                    <h4><%= block.label %></h4>
                                <% } %>
                                <% if (block.description) { %>
                                    <p class="text-muted"><%= block.description %></p>
                                <% } %>
                            </div>

                        <% } else if (block.type === 'short_answer') { %>
                            <div class="mb-3">
                                <label for="block_<%= block.blockId %>" class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <input
                                    type="<%= (block.config && block.config.validation === 'email') ? 'email' : (block.config && block.config.validation === 'url') ? 'url' : 'text' %>"
                                    class="form-control"
                                    id="block_<%= block.blockId %>"
                                    name="block_<%= block.blockId %>"
                                    <% if (block.config && block.config.placeholder) { %>placeholder="<%= block.config.placeholder %>"<% } %>
                                    <% if (block.config && block.config.minLength) { %>minlength="<%= block.config.minLength %>"<% } %>
                                    <% if (block.config && block.config.maxLength) { %>maxlength="<%= block.config.maxLength %>"<% } %>
                                    <% if (block.required) { %>required<% } %>
                                >
                            </div>

                        <% } else if (block.type === 'paragraph') { %>
                            <div class="mb-3">
                                <label for="block_<%= block.blockId %>" class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <textarea
                                    class="form-control"
                                    id="block_<%= block.blockId %>"
                                    name="block_<%= block.blockId %>"
                                    rows="4"
                                    <% if (block.config && block.config.placeholder) { %>placeholder="<%= block.config.placeholder %>"<% } %>
                                    <% if (block.config && block.config.minLength) { %>minlength="<%= block.config.minLength %>"<% } %>
                                    <% if (block.config && block.config.maxLength) { %>maxlength="<%= block.config.maxLength %>"<% } %>
                                    <% if (block.required) { %>required<% } %>
                                ></textarea>
                            </div>

                        <% } else if (block.type === 'multiple_choice') { %>
                            <div class="mb-3">
                                <label class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <% if (block.config && block.config.options) { %>
                                    <% block.config.options.forEach(function(option, optIndex) { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio"
                                                name="block_<%= block.blockId %>"
                                                id="block_<%= block.blockId %>_<%= optIndex %>"
                                                value="<%= option %>"
                                                <% if (block.required && optIndex === 0) { %>required<% } %>
                                                <% if (block.config.allowOther) { %>onchange="document.getElementById('block_<%= block.blockId %>_other_text').style.display='none'"<% } %>
                                            >
                                            <label class="form-check-label" for="block_<%= block.blockId %>_<%= optIndex %>">
                                                <%= option %>
                                            </label>
                                        </div>
                                    <% }) %>
                                    <% if (block.config.allowOther) { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio"
                                                name="block_<%= block.blockId %>"
                                                id="block_<%= block.blockId %>_other"
                                                value="__other__"
                                                onchange="document.getElementById('block_<%= block.blockId %>_other_text').style.display='block'"
                                            >
                                            <label class="form-check-label" for="block_<%= block.blockId %>_other">
                                                Other
                                            </label>
                                            <input type="text" class="form-control form-control-sm mt-1"
                                                id="block_<%= block.blockId %>_other_text"
                                                name="block_<%= block.blockId %>_other_text"
                                                placeholder="Please specify..."
                                                style="display:none;">
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>

                        <% } else if (block.type === 'checkboxes') { %>
                            <div class="mb-3">
                                <label class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <% if (block.config && block.config.options) { %>
                                    <% block.config.options.forEach(function(option, optIndex) { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                name="block_<%= block.blockId %>"
                                                id="block_<%= block.blockId %>_<%= optIndex %>"
                                                value="<%= option %>"
                                            >
                                            <label class="form-check-label" for="block_<%= block.blockId %>_<%= optIndex %>">
                                                <%= option %>
                                            </label>
                                        </div>
                                    <% }) %>
                                    <% if (block.config.allowOther) { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                name="block_<%= block.blockId %>"
                                                id="block_<%= block.blockId %>_other"
                                                value="__other__"
                                                onchange="document.getElementById('block_<%= block.blockId %>_other_text').style.display = this.checked ? 'block' : 'none'"
                                            >
                                            <label class="form-check-label" for="block_<%= block.blockId %>_other">
                                                Other
                                            </label>
                                            <input type="text" class="form-control form-control-sm mt-1"
                                                id="block_<%= block.blockId %>_other_text"
                                                name="block_<%= block.blockId %>_other_text"
                                                placeholder="Please specify..."
                                                style="display:none;">
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>

                        <% } else if (block.type === 'dropdown') { %>
                            <div class="mb-3">
                                <label for="block_<%= block.blockId %>" class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <select class="form-select" id="block_<%= block.blockId %>" name="block_<%= block.blockId %>"
                                    <% if (block.required) { %>required<% } %>
                                >
                                    <option value="" selected disabled>Select an option</option>
                                    <% if (block.config && block.config.options) { %>
                                        <% block.config.options.forEach(function(option) { %>
                                            <option value="<%= option %>"><%= option %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                        <% } else if (block.type === 'image_upload') { %>
                            <div class="mb-3">
                                <label class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <input type="hidden" name="block_<%= block.blockId %>" id="imgVal_<%= block.blockId %>" value="">
                                <div class="input-group">
                                    <input type="file" class="form-control" id="imgFile_<%= block.blockId %>" accept="image/png,image/jpeg,image/gif,image/webp">
                                    <button type="button" class="btn btn-outline-primary img-upload-btn" data-block-id="<%= block.blockId %>" disabled>
                                        <i class="fas fa-cloud-upload-alt me-1"></i>Upload
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <small class="img-upload-status text-muted" id="imgStatus_<%= block.blockId %>">PNG, JPG, GIF, or WebP — max <%= (block.config && block.config.maxSizeMB) || 8 %> MB</small>
                                </div>
                                <div class="mt-2 d-none" id="imgPreview_<%= block.blockId %>">
                                    <img src="" alt="Preview" class="img-fluid rounded" style="max-height:200px;">
                                </div>
                            </div>

                        <% } else if (block.type === 'linear_scale') { %>
                            <div class="mb-3">
                                <label class="form-label">
                                    <%= block.label %><% if (block.required) { %> <span class="text-danger">*</span><% } %>
                                </label>
                                <% if (block.description) { %>
                                    <small class="form-text text-muted d-block mb-1"><%= block.description %></small>
                                <% } %>
                                <%
                                    var scaleMin = (block.config && block.config.min !== undefined) ? block.config.min : 1;
                                    var scaleMax = (block.config && block.config.max !== undefined) ? block.config.max : 5;
                                    var minLabel = (block.config && block.config.minLabel) || '';
                                    var maxLabel = (block.config && block.config.maxLabel) || '';
                                %>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <% if (minLabel) { %><small class="text-muted"><%= minLabel %></small><% } %>
                                    <% for (var i = scaleMin; i <= scaleMax; i++) { %>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio"
                                                name="block_<%= block.blockId %>"
                                                id="block_<%= block.blockId %>_<%= i %>"
                                                value="<%= i %>"
                                                <% if (block.required && i === scaleMin) { %>required<% } %>
                                            >
                                            <label class="form-check-label" for="block_<%= block.blockId %>_<%= i %>">
                                                <%= i %>
                                            </label>
                                        </div>
                                    <% } %>
                                    <% if (maxLabel) { %><small class="text-muted"><%= maxLabel %></small><% } %>
                                </div>
                            </div>

                        <% } %>
                    <% }) %>

                    <% if (inSection) { %>
                        </div></div>
                    <% } %>

                    <% if (req.session.user && form.allowAnonymous) { %>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="submitAnonymous" name="submitAnonymous">
                            <label class="form-check-label" for="submitAnonymous">
                                Submit anonymously
                            </label>
                            <small class="form-text text-muted d-block">Your identity will not be recorded with this response.</small>
                        </div>
                    <% } %>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-paper-plane me-1"></i> Submit
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<script>
(function() {
    // Image upload handling
    document.querySelectorAll('.img-upload-btn').forEach(function(btn) {
        var blockId = btn.dataset.blockId;
        var fileInput = document.getElementById('imgFile_' + blockId);
        var hiddenInput = document.getElementById('imgVal_' + blockId);
        var statusEl = document.getElementById('imgStatus_' + blockId);
        var previewEl = document.getElementById('imgPreview_' + blockId);

        fileInput.addEventListener('change', function() { btn.disabled = !fileInput.files.length; });

        btn.addEventListener('click', async function() {
            var file = fileInput.files[0];
            if (!file) return;
            btn.disabled = true;
            statusEl.className = 'img-upload-status small text-info';
            statusEl.textContent = 'Uploading…';
            try {
                var fd = new FormData();
                fd.append('folder', 'zander/forms');
                fd.append('file', file);
                var res = await fetch('/api/upload/image', {
                    method: 'POST',
                    body: fd,
                    headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
                });
                var json = await res.json();
                if (json.success) {
                    hiddenInput.value = json.data.url;
                    statusEl.className = 'img-upload-status small text-success';
                    statusEl.textContent = 'Uploaded successfully';
                    var img = previewEl.querySelector('img');
                    img.src = json.data.url;
                    previewEl.classList.remove('d-none');
                } else {
                    statusEl.className = 'img-upload-status small text-danger';
                    statusEl.textContent = json.message || 'Upload failed';
                    btn.disabled = false;
                }
            } catch (e) {
                statusEl.className = 'img-upload-status small text-danger';
                statusEl.textContent = 'Upload failed';
                btn.disabled = false;
            }
        });
    });

    // Prevent double submission
    document.getElementById('formSubmission').addEventListener('submit', function() {
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';
    });
})();
</script>

<%- include("../../modules/footer.ejs") %>
