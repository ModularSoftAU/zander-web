<%- include("_top.ejs") %>

<a href="/mixed/matches" class="btn btn-sm btn-outline-secondary mb-3">← All matches</a>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-body">
        <h4><%= match.map_name || match.map_key || 'Match' %></h4>
        <p class="text-muted mb-2"><%= match.gamemode || '—' %> · <%= match.status %></p>
        <div class="row">
          <div class="col-6 col-md-3"><small class="text-muted d-block">Started</small><%= match.started_at ? moment(match.started_at).format('lll') : '—' %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Duration</small><%= match.duration_seconds ? Math.round(match.duration_seconds/60)+'m' : '—' %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Winner</small><%= (match.winners||[]).join(', ') || '—' %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Kills</small><%= match.total_kills %></div>
        </div>
        <% if (match.map_key) { %><a href="/mixed/maps/<%= encodeURIComponent(match.map_key) %>" class="btn btn-sm btn-outline-primary mt-3">View map</a><% } %>
      </div>
    </div>

    <h5>Scoreboard</h5>
    <div class="table-responsive mb-4">
      <table class="table table-sm">
        <thead><tr><th>Player</th><th>Team</th><th>K</th><th>D</th><th>A</th><th>Obj</th><th>XP</th></tr></thead>
        <tbody>
          <% match.players.forEach(function(p){ %>
            <tr class="<%= p.won ? 'table-success' : '' %>">
              <td><a href="/mixed/players/<%= p.player_uuid %>"><%= p.username || p.player_uuid %></a></td>
              <td><%= p.team_name || '—' %></td>
              <td><%= p.kills %></td><td><%= p.deaths %></td><td><%= p.assists %></td>
              <td><%= p.objectives %></td><td><%= p.xp_earned %></td>
            </tr>
          <% }) %>
          <% if (!match.players.length) { %><tr><td colspan="7" class="text-muted text-center">No player rows.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="col-lg-4">
    <h5>Timeline</h5>
    <div style="max-height:500px; overflow:auto;">
      <ul class="list-unstyled">
        <% events.filter(function(e){ return isAdmin || ['PLAYER_DEATH','OBJECTIVE_EVENT'].includes(e.event_type); }).forEach(function(e){ %>
          <li class="border-bottom py-1 small">
            <span class="text-muted"><%= e.occurred_at ? moment(e.occurred_at).format('HH:mm:ss') : '' %></span>
            <span class="badge bg-light text-dark"><%= e.event_type %></span>
          </li>
        <% }) %>
        <% if (!events.length) { %><li class="text-muted small">No events recorded.</li><% } %>
      </ul>
    </div>
    <% if (isAdmin) { %>
      <div class="alert alert-warning small mt-3">Admin view: showing raw event timeline (<%= events.length %> events).</div>
    <% } %>
  </div>
</div>

<%- include("_bottom.ejs") %>
