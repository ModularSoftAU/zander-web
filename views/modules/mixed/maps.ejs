<%- include("_top.ejs") %>

<form class="row g-2 mb-4" method="get">
  <div class="col-md-3"><input class="form-control form-control-sm" name="search" placeholder="Map name" value="<%= query.search || '' %>"></div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="gamemode" placeholder="Gamemode" value="<%= query.gamemode || '' %>"></div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="author" placeholder="Author" value="<%= query.author || '' %>"></div>
  <div class="col-md-3">
    <select class="form-select form-select-sm" name="sort">
      <% [["last_played", "Last played"], ["times_played", "Times played"], ["average_rating", "Rating"], ["average_duration", "Duration"], ["name", "Name"], ["gamemode", "Gamemode"], ["author", "Author"]].forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= (query.sort || "last_played") === o[0] ? "selected" : "" %>><%= o[1] %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Apply</button></div>
</form>

<div class="row g-3">
  <% result.maps.forEach(function(map){ %>
    <div class="col-md-4">
      <div class="card h-100 mixed-map-card">
        <a href="/mixed/maps/<%= encodeURIComponent(map.map_key) %>" class="mixed-map-link">
          <% if (map.display_image_url) { %>
            <img src="<%= map.display_image_url %>" class="card-img-top mixed-map-image" alt="<%= map.display_name %>">
          <% } else { %>
            <div class="mixed-map-placeholder"></div>
          <% } %>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-2 mixed-map-title"><%= map.display_name %></h5>
            <div class="mixed-map-meta">
              <span class="mixed-map-mode"><%= map.gamemode || "-" %></span>
              <span class="mixed-map-author"><%= (map.display_authors || []).join(", ") || "Unknown author" %></span>
            </div>
            <div class="d-flex justify-content-between small mixed-map-stats">
              <span><%= Number(map.average_overall || 0).toFixed(1) %>★ (<%= map.rating_count || 0 %>)</span>
              <span><%= map.times_played %> plays</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% }) %>
  <% if (!result.maps.length) { %>
    <div class="col-12">
      <div class="alert alert-secondary mb-0">
        <strong>No maps found.</strong>
        <div class="small mt-2">
          There are no maps available to show right now.
          <% if (isAdmin) { %>
            <a href="/dashboard/mixed/maps" class="alert-link">Open the Mixed maps dashboard</a> to review map setup and sync status.
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<% const totalPages = Math.max(1, Math.ceil(result.total / result.limit)); %>
<% if (totalPages > 1) { %>
  <nav><ul class="pagination pagination-sm mt-4 justify-content-center">
    <% for (let p = 1; p <= totalPages && p <= 20; p++) { const qs = new URLSearchParams({...query, page: p}); %>
      <li class="page-item <%= p === result.page ? "active" : "" %>"><a class="page-link" href="?<%= qs.toString() %>"><%= p %></a></li>
    <% } %>
  </ul></nav>
<% } %>

<%- include("_bottom.ejs") %>
