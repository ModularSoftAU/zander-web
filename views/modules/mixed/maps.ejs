<%- include("_top.ejs") %>

<form class="row g-2 mb-4" method="get">
  <div class="col-md-3"><input class="form-control form-control-sm" name="search" placeholder="Map name" value="<%= query.search || '' %>"></div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="gamemode" placeholder="Gamemode" value="<%= query.gamemode || '' %>"></div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="author" placeholder="Author" value="<%= query.author || '' %>"></div>
  <div class="col-md-3">
    <select class="form-select form-select-sm" name="sort">
      <% [["last_played", "Last played"], ["times_played", "Times played"], ["average_rating", "Rating"], ["average_duration", "Duration"], ["name", "Name"], ["gamemode", "Gamemode"], ["author", "Author"]].forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= (query.sort || "last_played") === o[0] ? "selected" : "" %>><%= o[1] %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Apply</button></div>
</form>

<div class="row g-3">
  <% result.maps.forEach(function(map){ %>
    <div class="col-md-4">
      <div class="card h-100">
        <% if (map.display_image_url) { %><img src="<%= map.display_image_url %>" class="card-img-top" style="height:150px;object-fit:cover;" alt="<%= map.name %>"><% } %>
        <div class="card-body">
          <h5 class="card-title mb-1"><a href="/mixed/maps/<%= encodeURIComponent(map.map_key) %>" class="text-reset text-decoration-none"><%= map.name %></a></h5>
          <p class="text-muted small mb-2"><%= map.gamemode || "-" %> - <%= (map.display_authors || []).join(", ") || "Unknown author" %></p>
          <div class="d-flex justify-content-between small">
            <span><%= Number(map.average_overall || 0).toFixed(1) %>★ (<%= map.rating_count || 0 %>)</span>
            <span><%= map.times_played %> plays</span>
          </div>
          <% if (isAdmin && map.source_key) { %>
            <div class="small text-muted mt-1">Source: <%= map.source_display_name || map.source_key %> (<%= map.source_repo %>)</div>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!result.maps.length) { %>
    <div class="col-12">
      <div class="alert alert-secondary mb-0">
        <strong>No maps found.</strong>
        <div class="small mt-2">
          Maps only appear here after Mixed data has been loaded into <code>mixed_maps</code>.
          That usually means either the Mixed plugin has not ingested any map or match data yet, or the GitHub map sync has not been enabled and run.
          <% if (isAdmin) { %>
            <a href="/dashboard/mixed/maps" class="alert-link">Open the Mixed maps dashboard</a> to check sync status and placeholder maps.
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<% const totalPages = Math.max(1, Math.ceil(result.total / result.limit)); %>
<% if (totalPages > 1) { %>
  <nav><ul class="pagination pagination-sm mt-4">
    <% for (let p = 1; p <= totalPages && p <= 20; p++) { const qs = new URLSearchParams({...query, page: p}); %>
      <li class="page-item <%= p===result.page?'active':'' %>"><a class="page-link" href="?<%= qs.toString() %>"><%= p %></a></li>
    <% } %>
  </ul></nav>
<% } %>

<%- include("_bottom.ejs") %>
