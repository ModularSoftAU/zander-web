<%- include("_top.ejs") %>

<div class="row g-3">
  <% servers.forEach(function(s){ %>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between">
          <strong><%= s.display_name %></strong>
          <span class="badge <%= s.online ? 'bg-success' : 'bg-secondary' %>"><%= s.online ? 'Online' : 'Offline' %></span>
        </div>
        <div class="card-body">
          <div class="row small">
            <div class="col-6 mb-1">Server ID: <code><%= s.server_id %></code></div>
            <div class="col-6 mb-1">Players: <%= s.player_count %></div>
            <div class="col-6 mb-1">Current map: <%= s.current_map_name || '—' %></div>
            <div class="col-6 mb-1">TPS: <%= s.tps ? Number(s.tps).toFixed(1) : '—' %></div>
            <div class="col-6 mb-1">PGM: <%= s.pgm_version || '—' %></div>
            <div class="col-6 mb-1">zander-pgm: <%= s.zander_pgm_version || '—' %></div>
            <div class="col-12">Last heartbeat: <%= s.last_heartbeat_at ? moment(s.last_heartbeat_at).fromNow() : '—' %></div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!servers.length) { %><div class="col-12"><div class="alert alert-secondary">No servers have reported in yet.</div></div><% } %>
</div>

<%- include("_bottom.ejs") %>
