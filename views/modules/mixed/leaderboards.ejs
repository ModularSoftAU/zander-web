<%- include("_top.ejs") %>

<p class="text-muted">Choose a leaderboard category. Each supports all-time rankings; time-windowed and per-map/gamemode variants are available via the API (<code>?limit=</code>).</p>

<div class="row g-2">
  <% categories.forEach(function(c){ %>
    <div class="col-md-3 col-6">
      <a href="/mixed/leaderboards/<%= c %>" class="btn mixed-tab-link w-100 text-capitalize"><%= c.replace(/_/g,' ') %></a>
    </div>
  <% }) %>
</div>

<%- include("_bottom.ejs") %>
