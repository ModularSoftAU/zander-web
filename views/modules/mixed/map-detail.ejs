<%- include("_top.ejs") %>
<% const rt = map.ratingTotals; const t = map.totals || {}; %>

<a href="/mixed/maps" class="btn btn-sm btn-outline-secondary mb-3">← All maps</a>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-4">
      <% if (map.thumbnail_url) { %><img src="<%= map.thumbnail_url %>" class="card-img-top" style="max-height:280px;object-fit:cover;" alt=""><% } %>
      <div class="card-body">
        <h3><%= map.name %> <small class="text-muted"><%= map.version || '' %></small></h3>
        <p class="text-muted"><%= map.gamemode || '—' %> · by <%= (map.authors||[]).join(', ') || 'Unknown' %></p>
        <% if (map.description) { %><p><%= map.description %></p><% } %>
        <% if ((map.objectives||[]).length) { %>
          <div><strong>Objectives:</strong> <%= (map.objectives||[]).map(o => typeof o === 'string' ? o : (o.name||'')).join(', ') %></div>
        <% } %>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3"><div class="card"><div class="card-body text-center py-2"><div class="h5 mb-0"><%= map.times_played %></div><small class="text-muted">Times played</small></div></div></div>
      <div class="col-6 col-md-3"><div class="card"><div class="card-body text-center py-2"><div class="h5 mb-0"><%= map.average_duration_seconds ? Math.round(map.average_duration_seconds/60)+'m' : '—' %></div><small class="text-muted">Avg duration</small></div></div></div>
      <div class="col-6 col-md-3"><div class="card"><div class="card-body text-center py-2"><div class="h5 mb-0"><%= t.fastest_match_seconds ? Math.round(t.fastest_match_seconds/60)+'m' : '—' %></div><small class="text-muted">Fastest</small></div></div></div>
      <div class="col-6 col-md-3"><div class="card"><div class="card-body text-center py-2"><div class="h5 mb-0"><%= t.longest_match_seconds ? Math.round(t.longest_match_seconds/60)+'m' : '—' %></div><small class="text-muted">Longest</small></div></div></div>
    </div>

    <h5>Recent matches</h5>
    <ul class="list-group mb-4">
      <% recentMatches.forEach(function(m){ %>
        <a href="/mixed/matches/<%= m.match_id %>" class="list-group-item list-group-item-action d-flex justify-content-between">
          <span><%= m.started_at ? moment(m.started_at).format('lll') : '—' %></span>
          <span class="text-muted small"><%= (m.winners||[]).join(', ') || '' %></span>
        </a>
      <% }) %>
      <% if (!recentMatches.length) { %><li class="list-group-item text-muted">No matches yet.</li><% } %>
    </ul>

    <% if (feedback.length) { %>
      <h5>Recent feedback</h5>
      <% feedback.forEach(function(f){ %>
        <div class="card mb-2"><div class="card-body py-2">
          <div class="d-flex justify-content-between"><strong><%= '★'.repeat(f.overall_rating) %></strong><span class="text-muted small"><%= f.username || 'Player' %> · <%= moment(f.created_at).fromNow() %></span></div>
          <div><%= f.feedback %></div>
        </div></div>
      <% }) %>
    <% } %>
  </div>

  <div class="col-lg-4">
    <div class="card mb-4">
      <div class="card-body text-center">
        <div class="display-5"><%= Number(rt.average_overall || 0).toFixed(1) %><small class="text-muted fs-5">/5</small></div>
        <div class="text-muted mb-3"><%= rt.rating_count %> ratings</div>
        <% [5,4,3,2,1].forEach(function(star){ const key = ['','one','two','three','four','five'][star]; const c = rt[key+'_star_count']||0; const pct = rt.rating_count ? Math.round(c/rt.rating_count*100) : 0; %>
          <div class="d-flex align-items-center mb-1">
            <span style="width:2.5rem;" class="small text-start"><%= star %>★</span>
            <div class="progress flex-grow-1" style="height:8px;"><div class="progress-bar bg-warning" style="width:<%= pct %>%"></div></div>
            <span style="width:2.5rem;" class="small text-end"><%= c %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card mb-4"><div class="card-body">
      <h6>Vote history</h6>
      <% if (!voteHistory.length) { %><div class="text-muted small">No votes yet.</div><% } %>
      <% voteHistory.forEach(function(v){ %>
        <div class="d-flex justify-content-between small border-bottom py-1">
          <span><%= v.started_at ? moment(v.started_at).format('MMM D') : '' %></span>
          <span><%= v.final_vote_count %> votes <%= v.winning_map_key === map.map_key ? '· won' : '' %></span>
        </div>
      <% }) %>
    </div></div>
  </div>
</div>

<%- include("_bottom.ejs") %>
