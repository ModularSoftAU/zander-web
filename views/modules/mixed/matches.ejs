<%- include("_top.ejs") %>

<form class="row g-2 mb-4" method="get">
  <div class="col-md-3"><input class="form-control form-control-sm" name="search" placeholder="Map name / match ID" value="<%= query.search || '' %>"></div>
  <div class="col-md-2">
    <select class="form-select form-select-sm" name="map">
      <option value="">Any map</option>
      <% maps.forEach(function(m){ %><option value="<%= m.map_key %>" <%= query.map===m.map_key?'selected':'' %>><%= m.name %></option><% }) %>
    </select>
  </div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="gamemode" placeholder="Gamemode" value="<%= query.gamemode || '' %>"></div>
  <div class="col-md-2">
    <select class="form-select form-select-sm" name="server">
      <option value="">Any server</option>
      <% servers.forEach(function(s){ %><option value="<%= s.server_id %>" <%= query.server===s.server_id?'selected':'' %>><%= s.display_name %></option><% }) %>
    </select>
  </div>
  <div class="col-md-2"><input class="form-control form-control-sm" name="player" placeholder="Player UUID" value="<%= query.player || '' %>"></div>
  <div class="col-md-1"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
</form>

<div class="table-responsive">
  <table class="table table-sm table-hover align-middle">
    <thead><tr>
      <th>Match</th><th>Map</th><th>Gamemode</th><th>Started</th><th>Duration</th><th>Winner</th><th>Players</th><th>Kills</th><th>Obj</th>
    </tr></thead>
    <tbody>
      <% result.matches.forEach(function(m){ %>
        <tr>
          <td><a href="/mixed/matches/<%= m.match_id %>"><%= String(m.match_id).slice(0,8) %></a></td>
          <td><%= m.map_name || m.map_key || '—' %></td>
          <td><%= m.gamemode || '—' %></td>
          <td><%= m.started_at ? moment(m.started_at).format('YYYY-MM-DD HH:mm') : '—' %></td>
          <td><%= m.duration_seconds ? Math.round(m.duration_seconds/60)+'m' : '—' %></td>
          <td><%= (m.winners||[]).join(', ') || '—' %></td>
          <td><%= m.participants_count %></td>
          <td><%= m.total_kills %></td>
          <td><%= m.total_objectives %></td>
        </tr>
      <% }) %>
      <% if (!result.matches.length) { %><tr><td colspan="9" class="text-muted text-center">No matches found.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% const totalPages = Math.max(1, Math.ceil(result.total / result.limit)); %>
<% if (totalPages > 1) { %>
  <nav><ul class="pagination pagination-sm">
    <% for (let p = 1; p <= totalPages && p <= 20; p++) { const qs = new URLSearchParams({...query, page: p}); %>
      <li class="page-item <%= p===result.page?'active':'' %>"><a class="page-link" href="?<%= qs.toString() %>"><%= p %></a></li>
    <% } %>
  </ul></nav>
<% } %>

<%- include("_bottom.ejs") %>
