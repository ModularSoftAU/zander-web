<%- include("_top.ejs") %>

<div id="liveContainer" class="row g-3">
  <% if (!live.length) { %>
    <div class="col-12"><div class="alert alert-secondary">No active matches right now.</div></div>
  <% } %>
  <% live.forEach(function(m){ %>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= m.server_name %></strong>
          <span class="badge <%= m.server_online ? 'bg-success' : 'bg-secondary' %>"><%= m.server_online ? 'Online' : 'Offline' %></span>
        </div>
        <div class="card-body">
          <h5><a href="/mixed/matches/<%= m.match_id %>" class="text-reset text-decoration-none"><%= m.map_name || m.map_key %></a></h5>
          <p class="text-muted mb-2"><%= m.gamemode || '—' %> · Status: <%= m.status %></p>
          <div class="d-flex justify-content-between small">
            <span><i class="fas fa-users me-1"></i><%= m.server_players %> players</span>
            <span><i class="fas fa-clock me-1"></i><%= m.started_at ? moment(m.started_at).fromNow(true) : '—' %></span>
            <% if (m.tps) { %><span>TPS <%= Number(m.tps).toFixed(1) %></span><% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="card mt-4">
  <div class="card-header"><strong>Live feed</strong></div>
  <div class="card-body" id="liveFeed" style="max-height: 300px; overflow:auto;">
    <div class="text-muted small">Connecting to live updates…</div>
  </div>
</div>

<script>
  // Subscribe to the Mixed SSE stream for kill / objective / match updates.
  (function(){
    const feed = document.getElementById('liveFeed');
    function add(text){
      const el = document.createElement('div');
      el.className = 'small border-bottom py-1';
      el.textContent = new Date().toLocaleTimeString() + ' — ' + text;
      feed.prepend(el);
    }
    try {
      const es = new EventSource('/api/mixed/stream');
      es.addEventListener('connected', () => { feed.innerHTML=''; add('Connected to live feed.'); });
      ['PLAYER_DEATH','OBJECTIVE_EVENT','LIVE_FEED_EVENT','MATCH_STARTED','MATCH_ENDED','HEARTBEAT'].forEach(function(t){
        es.addEventListener(t, function(e){
          try { const d = JSON.parse(e.data); add(t + ': ' + JSON.stringify(d.payload).slice(0,160)); } catch(_){}
          if (t === 'MATCH_ENDED' || t === 'MATCH_STARTED') setTimeout(()=>location.reload(), 3000);
        });
      });
    } catch(e){ add('Live updates unavailable.'); }
  })();
</script>

<%- include("_bottom.ejs") %>
