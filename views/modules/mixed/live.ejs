<%- include("_top.ejs") %>

<div id="liveContainer" class="row g-3">
  <% if (!live.length && !(idleServers || []).length) { %>
    <div class="col-12"><div class="alert alert-secondary">No active or idle Mixed servers right now.</div></div>
  <% } %>

  <% if (!live.length && (idleServers || []).length) { %>
    <div class="col-12">
      <div class="alert alert-secondary mb-0">
        No active matches right now. The following Mixed servers are idle on their current maps.
      </div>
    </div>
  <% } %>

  <% (idleServers || []).forEach(function(s){ %>
    <div class="col-md-6">
      <div class="card h-100 mixed-map-detail-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= s.display_name %></strong>
          <span class="badge bg-secondary">Idle</span>
        </div>
        <div class="card-body">
          <h5 class="text-reset mb-1"><%= s.current_map_name || s.current_map_key || "Waiting for a map" %></h5>
          <p class="text-muted mb-2">Current map loaded, waiting for players to start a match.</p>
          <div class="d-flex justify-content-between small">
            <span><i class="fas fa-users me-1"></i><%= s.player_count %> players</span>
            <% if (s.tps) { %><span>TPS <%= Number(s.tps).toFixed(1) %></span><% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>

  <% live.forEach(function(m){ %>
    <div class="col-md-6">
      <div class="card h-100 mixed-map-detail-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= m.server_name %></strong>
          <span class="badge <%= m.server_online ? 'bg-success' : 'bg-secondary' %>"><%= m.server_online ? 'Online' : 'Offline' %></span>
        </div>
        <% if (m.display_image_url) { %>
          <img src="<%= m.display_image_url %>" class="card-img-top mixed-map-image" alt="<%= m.display_map_name %>">
        <% } %>
        <div class="card-body">
          <h5><a href="/mixed/matches/<%= m.match_id %>" class="text-reset text-decoration-none"><%= m.display_map_name %></a></h5>
          <p class="text-muted mb-2"><%= m.gamemode || "-" %> - Status: <%= m.status %></p>
          <div class="d-flex justify-content-between small">
            <span><i class="fas fa-users me-1"></i><%= m.server_players %> players</span>
            <span><i class="fas fa-clock me-1"></i><%= m.started_at ? moment(m.started_at).fromNow(true) : "-" %></span>
            <% if (m.tps) { %><span>TPS <%= Number(m.tps).toFixed(1) %></span><% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
  // Reload the page when a match starts/ends so the live cards stay current.
  (function(){
    try {
      const es = new EventSource('/api/mixed/stream');
      ['MATCH_STARTED','MATCH_ENDED'].forEach(function(t){
        es.addEventListener(t, function(){ setTimeout(()=>location.reload(), 3000); });
      });
    } catch(e){}
  })();
</script>

<%- include("_bottom.ejs") %>
