<%- include("_top.ejs") %>

<form class="row g-2 mb-4" method="get">
  <div class="col-md-4"><input class="form-control form-control-sm" name="search" placeholder="Username or UUID" value="<%= query.search || '' %>"></div>
  <div class="col-md-3">
    <select class="form-select form-select-sm" name="sort">
      <% [['total_xp','XP'],['level','Level'],['wins','Wins'],['kills','Kills'],['objectives','Objectives'],['last_seen','Last seen']].forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= (query.sort||'total_xp')===o[0]?'selected':'' %>><%= o[1] %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Search</button></div>
</form>

<div class="card shadow-sm border-0 mixed-table-card">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0" data-mixed-datatable="server-paged">
      <thead class="table-light"><tr><th>Player</th><th>Lvl</th><th>XP</th><th>W</th><th>L</th><th>K/D</th><th>Obj</th><th>Last played</th></tr></thead>
      <tbody>
        <% result.players.forEach(function(p){ %>
          <tr class="mixed-list-item">
            <td>
              <a href="/mixed/players/<%= p.player_uuid %>" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="https://crafatar.com/avatars/<%= p.player_uuid %>?size=24&overlay" width="24" height="24" class="rounded flex-shrink-0" alt="" onerror="this.style.display='none'">
                <span><%= p.username || p.player_uuid %></span>
              </a>
            </td>
            <td><%= p.level %></td><td><%= p.total_xp %></td><td><%= p.wins %></td><td><%= p.losses %></td>
            <td><%= (p.kills/Math.max(1,p.deaths)).toFixed(2) %></td><td><%= p.objectives %></td>
            <td><%= p.last_seen_at ? moment(p.last_seen_at).fromNow() : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (!result.players.length) { %><div class="text-muted text-center py-3">No players found.</div><% } %>
  </div>
</div>

<% const totalPages = Math.max(1, Math.ceil(result.total / result.limit)); %>
<% if (totalPages > 1) { %>
  <nav class="mixed-table-nav"><ul class="pagination pagination-sm justify-content-center">
    <% for (let p = 1; p <= totalPages && p <= 20; p++) { const qs = new URLSearchParams({...query, page: p}); %>
      <li class="page-item <%= p===result.page?'active':'' %>"><a class="page-link" href="?<%= qs.toString() %>"><%= p %></a></li>
    <% } %>
  </ul></nav>
<% } %>

<%- include("_bottom.ejs") %>
