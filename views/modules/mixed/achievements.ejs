<%- include("_top.ejs") %>

<div class="row g-3">
  <% achievements.forEach(function(a){ %>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="d-flex justify-content-between mb-1">
          <h6 class="mb-0"><%= a.name %></h6>
          <span class="badge bg-info text-dark text-capitalize"><%= a.rarity %></span>
        </div>
        <p class="small text-muted mb-2"><%= a.description || '' %></p>
        <div class="d-flex justify-content-between small">
          <span><%= a.xp_reward %> XP</span>
          <span><%= a.unlock_count %> unlocked</span>
        </div>
        <% if ((a.recent||[]).length) { %>
          <div class="mt-2 small text-muted">Recent: <%= a.recent.map(r => r.username || 'player').join(', ') %></div>
        <% } %>
      </div></div>
    </div>
  <% }) %>
  <% if (!achievements.length) { %><div class="col-12"><div class="alert alert-secondary">No achievements defined yet.</div></div><% } %>
</div>

<%- include("_bottom.ejs") %>
