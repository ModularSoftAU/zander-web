<%- include("_top.ejs") %>

<ul class="nav nav-pills mixed-leaderboard-tabs mb-3 flex-wrap gap-1">
  <% categories.forEach(function(c){ %>
    <li class="nav-item">
      <a href="/mixed/leaderboards/<%= c %>" class="nav-link text-capitalize <%= c === category ? 'active' : '' %>"><%= c.replace(/_/g,' ') %></a>
    </li>
  <% }) %>
</ul>

<div class="card shadow-sm border-0 mixed-table-card">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light"><tr><th style="width:1%">#</th><th>Player</th><th class="text-end">Score</th></tr></thead>
      <tbody>
        <% board.forEach(function(p, i){ %>
          <tr class="mixed-list-item">
            <td class="text-muted"><%= i + 1 %></td>
            <td>
              <a href="/mixed/players/<%= p.player_uuid %>" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="https://crafatar.com/avatars/<%= p.player_uuid %>?size=24&overlay" width="24" height="24" class="rounded flex-shrink-0" alt="" onerror="this.style.display='none'">
                <span><%= p.username || p.player_uuid %></span>
              </a>
            </td>
            <td class="text-end fw-semibold"><%= typeof p.score === 'number' ? (Number.isInteger(p.score) ? p.score : p.score.toFixed(2)) : p.score %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (!board.length) { %><div class="text-muted text-center py-3">No ranked players yet.</div><% } %>
  </div>
</div>

<%- include("_bottom.ejs") %>
