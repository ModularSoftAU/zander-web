  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (!window.jQuery || !jQuery.fn || !jQuery.fn.DataTable) return;

    document.querySelectorAll("table[data-mixed-datatable]").forEach(function (table) {
      if (jQuery.fn.DataTable.isDataTable(table)) return;

      const mode = table.getAttribute("data-mixed-datatable");
      const options = {
        autoWidth: false,
        responsive: false,
        language: {
          emptyTable: "No rows available.",
          zeroRecords: "No matching rows found.",
        },
      };

      if (mode === "server-paged") {
        Object.assign(options, {
          paging: false,
          info: false,
          searching: false,
          lengthChange: false,
          dom: "t",
        });
      } else if (mode === "scoreboard") {
        Object.assign(options, {
          paging: false,
          info: false,
          searching: false,
          lengthChange: false,
          dom: "t",
          order: [[2, "desc"]],
        });
      }

      jQuery(table).DataTable(options);
    });
  });
</script>

