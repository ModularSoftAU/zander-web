<% if (typeof mixedHighlight !== 'undefined' && mixedHighlight) { %>
  <section class="mixed-highlight-banner py-3" style="background: var(--bs-dark, #14161c); border-bottom: 1px solid rgba(255,255,255,0.08);">
    <div class="container">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-danger text-uppercase"><i class="fas fa-circle me-1" style="font-size: 0.5em; vertical-align: middle;"></i>Live now</span>
          <span class="text-white">
            <strong><%= mixedHighlight.map_name || mixedHighlight.map_key %></strong>
            on Mixed — <i class="fas fa-users me-1"></i><%= mixedHighlight.server_players %> players online
          </span>
        </div>
        <a href="/play" class="btn btn-main-2 btn-sm btn-round-full">Join the Match <i class="fa-solid fa-right-long"></i></a>
      </div>
    </div>
  </section>
<% } %>
