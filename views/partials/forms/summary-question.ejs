<%
/**
 * Renders the summary visualisation for a single question.
 * Expects: q (summary object from buildFormSummary)
 */
%>

<% if (q.answered === 0) { %>
    <p class="text-muted mb-0">No responses yet.</p>

<% } else if (q.optionCounts) { %>
    <%/* multiple_choice, checkboxes, dropdown */%>
    <% q.optionCounts.forEach(function(opt) { %>
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold"><%= opt.label %></span>
                <span class="small text-muted"><%= opt.count %> (<%= opt.percentage %>%)</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar" role="progressbar" style="width: <%= opt.percentage %>%;" aria-valuenow="<%= opt.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    <% }) %>

<% } else if (q.distribution) { %>
    <%/* linear_scale */%>
    <div class="mb-2">
        <span class="fw-semibold">Average: </span>
        <span class="badge bg-primary fs-6"><%= q.average %></span>
        <% if (q.minLabel || q.maxLabel) { %>
            <small class="text-muted ms-2">(<%= q.minLabel || q.distribution[0].value %> &ndash; <%= q.maxLabel || q.distribution[q.distribution.length - 1].value %>)</small>
        <% } %>
    </div>
    <% q.distribution.forEach(function(d) { %>
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold"><%= d.value %></span>
                <span class="small text-muted"><%= d.count %> (<%= d.percentage %>%)</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: <%= d.percentage %>%;" aria-valuenow="<%= d.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    <% }) %>

<% } else if (q.imageUrls) { %>
    <%/* image_upload */%>
    <div class="d-flex flex-wrap gap-2">
        <% q.imageUrls.forEach(function(url) { %>
            <a href="<%= url %>" target="_blank" rel="noopener">
                <img src="<%= url %>" alt="Upload" class="rounded" style="height:80px;width:80px;object-fit:cover;">
            </a>
        <% }) %>
    </div>

<% } else if (q.textAnswers) { %>
    <%/* short_answer, paragraph */%>
    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
        <table class="table table-sm table-borderless mb-0">
            <tbody>
                <% q.textAnswers.forEach(function(ans) { %>
                    <tr>
                        <td class="small" style="white-space: pre-wrap;"><%= ans %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

<% } %>
