<div class="announcement-row border rounded p-3 mb-2 position-relative">
    <button type="button" class="btn btn-xs btn-danger position-absolute top-0 end-0 m-2 remove-announcement">×</button>
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small">Label</label>
            <input type="text" class="form-control form-control-sm ann-label" placeholder="e.g. 24h Reminder" value="<%= announcement.label || '' %>">
        </div>
        <div class="col-md-2">
            <label class="form-label small">Type</label>
            <select class="form-select form-select-sm ann-type">
                <option value="on_publish" <%= announcement.announcementType === 'on_publish' ? 'selected' : '' %>>On Publish</option>
                <option value="reminder" <%= announcement.announcementType === 'reminder' ? 'selected' : '' %>>Reminder</option>
                <option value="event_start" <%= announcement.announcementType === 'event_start' ? 'selected' : '' %>>At Start</option>
                <option value="recap" <%= announcement.announcementType === 'recap' ? 'selected' : '' %>>Recap</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Trigger</label>
            <select class="form-select form-select-sm ann-trigger">
                <option value="on_publish" <%= announcement.triggerType === 'on_publish' ? 'selected' : '' %>>On Publish</option>
                <option value="before_event" <%= announcement.triggerType === 'before_event' ? 'selected' : '' %>>Before Event</option>
                <option value="event_start" <%= announcement.triggerType === 'event_start' ? 'selected' : '' %>>Event Start</option>
            </select>
        </div>
        <div class="col-md-2 ann-offset-group <%= announcement.triggerType !== 'before_event' ? 'd-none' : '' %>">
            <label class="form-label small">Minutes Before</label>
            <input type="number" class="form-control form-control-sm ann-offsetMinutes" placeholder="60" min="0" value="<%= announcement.offsetMinutes || '' %>">
        </div>
        <div class="col-md-3">
            <label class="form-label small">Channel ID</label>
            <input type="text" class="form-control form-control-sm ann-channelId" placeholder="Discord Channel ID" value="<%= announcement.channelId || '' %>">
        </div>
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small mb-0">Content Template <small class="text-muted">(leave blank for default)</small></label>
                <div class="dropdown">
                    <button type="button" class="btn btn-xs btn-outline-secondary dropdown-toggle ann-ts-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fab fa-discord me-1"></i>Timestamps
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:260px;font-size:0.8rem;">
                        <li><h6 class="dropdown-header">Start time</h6></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{startAt}"><code>{startAt}</code> <span class="text-muted">— Tue, 20 Apr 2021 09:01</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{startRelative}"><code>{startRelative}</code> <span class="text-muted">— in 2 months</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{discord_f}"><code>{discord_f}</code> <span class="text-muted">— 20 April 2021 09:01</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{discord_d}"><code>{discord_d}</code> <span class="text-muted">— 20/04/2021</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{discord_D}"><code>{discord_D}</code> <span class="text-muted">— 20 April 2021</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{discord_t}"><code>{discord_t}</code> <span class="text-muted">— 9:01 AM</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{discord_T}"><code>{discord_T}</code> <span class="text-muted">— 9:01:00 AM</span></a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">End time</h6></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{endAt}"><code>{endAt}</code> <span class="text-muted">— Tue, 20 Apr 2021 10:01</span></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{endRelative}"><code>{endRelative}</code> <span class="text-muted">— in 3 months</span></a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Other tokens</h6></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{title}"><code>{title}</code></a></li>
                        <li><a class="dropdown-item ann-ts-insert" href="#" data-token="{location}"><code>{location}</code></a></li>
                    </ul>
                </div>
            </div>
            <textarea class="form-control form-control-sm ann-contentTemplate" rows="2" placeholder="Use {title}, {startAt}, {startRelative}, {endAt}…"><%= announcement.contentTemplate || '' %></textarea>
        </div>
    </div>
</div>
<script>
(function() {
    const rows = document.querySelectorAll('#announcementsContainer .announcement-row');
    const row = rows[rows.length - 1];
    if (!row) return;
    row.querySelector('.remove-announcement').addEventListener('click', () => row.remove());
    const trigger = row.querySelector('.ann-trigger');
    const offsetGroup = row.querySelector('.ann-offset-group');
    if (trigger && offsetGroup) {
        const toggle = () => offsetGroup.classList.toggle('d-none', trigger.value !== 'before_event');
        trigger.addEventListener('change', toggle);
    }
    row.querySelectorAll('.ann-ts-insert').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const ta = row.querySelector('.ann-contentTemplate');
            const token = link.dataset.token;
            const start = ta.selectionStart, end = ta.selectionEnd;
            ta.value = ta.value.slice(0, start) + token + ta.value.slice(end);
            ta.selectionStart = ta.selectionEnd = start + token.length;
            ta.focus();
        });
    });
})();
</script>
